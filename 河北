-- 河北唐县 脚本 v1.2
-- WindUI版 | 远程买车(不触发键盘检测) | 冰淇淋刷钱 | 传送玩家 | 透视 | 调速度
local WI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()
if not WI then return end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Settings = {
    AutoIceCream = false,
    ESP_Enabled = false,
    WalkSpeed = 16,
}

local VERSION = "v1.2"
local stopAll = false
local highlights = {}
local nameTags = {}
local firstRun = true

-- ==================== 获取位置 ====================
local function getPos()
    local c = LocalPlayer.Character
    if c and c:FindFirstChild("HumanoidRootPart") then
        return c.HumanoidRootPart.Position
    end
    return nil
end

-- ==================== 瞬移 ====================
local function tp(pos)
    local c = LocalPlayer.Character
    if c and c:FindFirstChild("HumanoidRootPart") then
        c.HumanoidRootPart.CFrame = CFrame.new(pos)
    end
end

-- ==================== 触发附近交互（不触发键盘检测） ====================
local function interactNearby()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    -- 触发ProximityPrompt
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local parent = obj.Parent
            if parent and parent:IsA("BasePart") then
                local dist = (root.Position - parent.Position).Magnitude
                if dist < 20 then
                    pcall(function() fireproximityprompt(obj) end)
                end
            end
        end
    end
    
    -- 触发ClickDetector
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("ClickDetector") then
            local parent = obj.Parent
            if parent and parent:IsA("BasePart") then
                local dist = (root.Position - parent.Position).Magnitude
                if dist < 20 then
                    pcall(function() fireclickdetector(obj) end)
                end
            end
        end
    end
end

-- ==================== 远程买车 ====================
local function buyCar()
    local returnPos = getPos()
    if not returnPos then return end
    
    -- 传送到买车坐标
    tp(Vector3.new(-3307, 11.8, 3799))
    
    -- 停留2秒
    task.wait(2)
    
    -- 疯狂触发交互2秒（不触发键盘检测）
    local t = tick()
    while tick() - t < 2 do
        interactNearby()
        task.wait(0.05)
    end
    
    task.wait(0.3)
    
    -- 传送回原来位置
    tp(returnPos)
end

-- ==================== 冰淇淋刷钱 ====================
task.spawn(function()
    while true do
        if Settings.AutoIceCream and not stopAll then
            
            if firstRun then
                pcall(function()
                    ReplicatedStorage.Feature_RemoteEvent.TeamSwitch:FireServer("Mixue Ice Cream")
                end)
                task.wait(2)
                firstRun = false
            end
            
            if not Settings.AutoIceCream or stopAll then continue end
            
            pcall(function()
                ReplicatedStorage.JobDataEvent:FireServer("GrabCone")
            end)
            task.wait(0.3)
            
            if not Settings.AutoIceCream or stopAll then continue end
            
            pcall(function()
                ReplicatedStorage.JobDataEvent:FireServer("FillCone")
            end)
            task.wait(0.3)
            
            if not Settings.AutoIceCream or stopAll then continue end
            
            pcall(function()
                local function GetNil(Name, DebugId)
                    for _, Object in getnilinstances() do
                        if Object.Name == Name and Object:GetDebugId() == DebugId then
                            return Object
                        end
                    end
                end
                ReplicatedStorage.JobDataEvent:FireServer("ServeCustomer", GetNil("Customer5", "0_471794"))
            end)
            
            task.wait(0.5)
        else
            task.wait(1)
        end
    end
end)

-- ==================== ESP ====================
local function clearESP()
    for _, h in pairs(highlights) do pcall(function() h:Destroy() end) end
    for _, t in pairs(nameTags) do pcall(function() t:Destroy() end) end
    table.clear(highlights)
    table.clear(nameTags)
end

RunService.Heartbeat:Connect(function()
    if not Settings.ESP_Enabled then clearESP() return end
    for _, plr in pairs(Players:GetPlayers()) do
        if plr == LocalPlayer then
            if highlights[plr] then pcall(function() highlights[plr]:Destroy() end) highlights[plr] = nil end
            if nameTags[plr] then pcall(function() nameTags[plr]:Destroy() end) nameTags[plr] = nil end
        else
            local char = plr.Character
            if char and char:FindFirstChild("Head") then
                if not highlights[plr] then
                    local h = Instance.new("Highlight")
                    h.FillColor = Color3.fromRGB(255, 100, 100)
                    h.FillTransparency = 0.5
                    h.OutlineColor = Color3.fromRGB(255, 50, 50)
                    h.OutlineTransparency = 0.3
                    highlights[plr] = h
                end
                if highlights[plr] and highlights[plr].Parent ~= char then highlights[plr].Parent = char end
                if not nameTags[plr] then
                    local bg = Instance.new("BillboardGui")
                    bg.Size = UDim2.new(0, 120, 0, 25)
                    bg.AlwaysOnTop = true
                    bg.MaxDistance = math.huge
                    local l = Instance.new("TextLabel")
                    l.Size = UDim2.new(1, 0, 1, 0)
                    l.BackgroundTransparency = 1
                    l.Text = plr.Name
                    l.TextColor3 = Color3.fromRGB(255, 255, 255)
                    l.Font = Enum.Font.GothamBold
                    l.TextSize = 14
                    l.TextStrokeTransparency = 0.5
                    l.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                    l.Parent = bg
                    nameTags[plr] = bg
                end
                if nameTags[plr] and nameTags[plr].Parent ~= char.Head then nameTags[plr].Parent = char.Head end
            end
        end
    end
end)

Players.PlayerRemoving:Connect(function(plr)
    if highlights[plr] then pcall(function() highlights[plr]:Destroy() end) highlights[plr] = nil end
    if nameTags[plr] then pcall(function() nameTags[plr]:Destroy() end) nameTags[plr] = nil end
end)

-- ==================== 调速 ====================
local function setSpeed(s)
    local c = LocalPlayer.Character
    if c and c:FindFirstChild("Humanoid") then c.Humanoid.WalkSpeed = s end
end

task.spawn(function()
    while true do
        if Settings.WalkSpeed ~= 16 then setSpeed(Settings.WalkSpeed) end
        task.wait(0.05)
    end
end)

-- ==================== 玩家列表 ====================
local function getPlayerNames()
    local names = {}
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then table.insert(names, plr.Name) end
    end
    if #names == 0 then table.insert(names, "无其他玩家") end
    return names
end

