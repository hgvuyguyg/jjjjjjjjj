WindUI:AddTheme({
    Name = "冰白",
    Accent = "#80C0FF",
    Outline = "#6090C0",
    Text = "#FFFFFF",
    Placeholder = "#D0E0FF",
})

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local VirtualInputManager = game:GetService("VirtualInputManager")

local Settings = {
    AutoCollectEnabled = false,
    CollectDelay = 1,
    CollectRange = 100,
    AntiAFKEnabled = false,
    AutoSellEnabled = false,
    SellDelay = 30,
    SpeedEnabled = false,
    SpeedValue = 100,
}

local VERSION = "v1.1.3"
local lastCollectTime = 0
local lastOreScan = 0
local cachedOres = {}
local lastAFKTime = 0
local lastSellTime = 0

local ORE_NAMES_COLLECT = {
    "Sapphire Ore", "Zinc Ore", "Coal Ore", "Iron Ore", "Gold Ore", "Diamond Ore",
    "Ruby Ore", "Emerald Ore", "Copper Ore", "Silver Ore", "Platinum Ore",
    "Titanium Ore", "Uranium Ore", "Mithril Ore", "Adamantite Ore",
    "Amethyst Ore", "Topaz Ore", "Jade Ore", "Obsidian Ore", "Quartz Ore",
}

local function getAllOres()
    local ores = {}
    local myPosition = nil
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        myPosition = LocalPlayer.Character.HumanoidRootPart.Position
    end
    
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name then
            for _, oreName in pairs(ORE_NAMES_COLLECT) do
                if obj.Name:find(oreName) then
                    local rootPart = nil
                    if obj:IsA("Model") then
                        rootPart = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                    elseif obj:IsA("BasePart") then
                        rootPart = obj
                    end
                    
                    if rootPart then
                        local distance = 0
                        if myPosition then
                            distance = (myPosition - rootPart.Position).Magnitude
                        end
                        
                        if distance <= Settings.CollectRange then
                            table.insert(ores, {
                                FullID = obj.Name,
                                Position = rootPart.Position,
                                Distance = distance,
                            })
                        end
                    end
                    break
                end
            end
        end
    end
    
    pcall(function()
        for _, obj in getnilinstances() do
            if obj.Name then
                for _, oreName in pairs(ORE_NAMES_COLLECT) do
                    if obj.Name:find(oreName) then
                        local distance = 0
                        if myPosition and obj:IsA("BasePart") then
                            distance = (myPosition - obj.Position).Magnitude
                        end
                        if distance <= Settings.CollectRange then
                            table.insert(ores, {
                                FullID = obj.Name,
                                Position = obj.Position,
                                Distance = distance,
                            })
                        end
                        break
                    end
                end
            end
        end
    end)
    
    table.sort(ores, function(a, b) return a.Distance < b.Distance end)
    
    cachedOres = ores
    lastOreScan = tick()
    return ores
end

local function autoCollect()
    local Event = ReplicatedStorage:FindFirstChild("shared/network/MiningNetwork@GlobalMiningEvents") and ReplicatedStorage["shared/network/MiningNetwork@GlobalMiningEvents"]:FindFirstChild("CollectItem")
    if not Event then return false end
    
    local ores = getAllOres()
    if #ores == 0 then return false end
    
    local collected = false
    for _, ore in pairs(ores) do
        pcall(function()
            Event:FireServer(ore.FullID)
            collected = true
        end)
    end
    
    return collected
end

task.spawn(function()
    while true do
        if Settings.AutoCollectEnabled then
            local currentTime = tick()
            if currentTime - lastCollectTime >= Settings.CollectDelay then
                autoCollect()
                lastCollectTime = currentTime
                lastOreScan = 0
            end
        end
        task.wait(0.05)
    end
end)

local function teleportTo(pos, name)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        WindUI:Notify({Title = "传送失败", Content = "角色未加载", Duration = 2})
        return
    end
    character.HumanoidRootPart.CFrame = CFrame.new(pos)
    WindUI:Notify({Title = "传送成功", Content = "已传送到" .. name, Duration = 2})
end

task.spawn(function()
    while true do
        if Settings.AntiAFKEnabled then
            local currentTime = tick()
            if currentTime - lastAFKTime >= 18 * 60 then
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, nil)
                task.wait(0.1)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, nil)
                lastAFKTime = currentTime
            end
        end
        task.wait(1)
    end
end)

local function autoSell()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return false end
    
    local rootPart = character.HumanoidRootPart
    local originalPos = rootPart.Position
    
    rootPart.CFrame = CFrame.new(1019.7, 245.0, -64.5)
    task.wait(0.5)
    
    local Event = ReplicatedStorage:FindFirstChild("Ml") and ReplicatedStorage.Ml:FindFirstChild("SellInventory")
    if Event then
        Event:FireServer()
    end
    
    task.wait(0.5)
    rootPart.CFrame = CFrame.new(originalPos)
    
    return true
end

task.spawn(function()
    while true do
        if Settings.AutoSellEnabled then
            local currentTime = tick()
            if currentTime - lastSellTime >= Settings.SellDelay then
                autoSell()
                lastSellTime = currentTime
            end
        end
        task.wait(0.5)
    end
end)

local function setSpeed()
    local player = LocalPlayer
    if player and player.Character and player.Character:FindFirstChild("Humanoid") then
        player.Character.Humanoid.WalkSpeed = Settings.SpeedValue
    end
end

RunService.Heartbeat:Connect(function()
    if Settings.SpeedEnabled then
        setSpeed()
    end
end)

