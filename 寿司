-- 获取根部件
local function getRoot(obj)
    if obj:IsA("Model") then
        return obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
    elseif obj:IsA("BasePart") then
        return obj
    end
    return nil
end

-- 获取父级Model
local function getParentModel(obj)
    local parent = obj.Parent
    while parent and parent ~= Workspace do
        if parent:IsA("Model") then
            return parent
        end
        parent = parent.Parent
    end
    return obj
end

-- 清理ESP
local function clearESP()
    for _, h in pairs(espHighlights) do
        pcall(function() h:Destroy() end)
    end
    for _, t in pairs(espNameTags) do
        pcall(function() t:Destroy() end)
    end
    table.clear(espHighlights)
    table.clear(espNameTags)
    table.clear(espTargets)
end

-- 更新ESP
local function updateESP()
    clearESP()
    
    local character = LocalPlayer.Character
    local characterRoot = character and character:FindFirstChild("HumanoidRootPart")
    local seenModels = {}
    
    if Settings.NoriMonsterESP then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj.Name and obj.Name:lower():find("norimonster") then
                local parentModel = getParentModel(obj)
                
                if not seenModels[parentModel] then
                    seenModels[parentModel] = true
                    
                    local rootPart = getRoot(parentModel)
                    if rootPart and rootPart:IsA("BasePart") and rootPart.Parent then
                        local h = Instance.new("Highlight")
                        h.FillColor = Color3.fromRGB(255, 0, 0)
                        h.FillTransparency = 0.5
                        h.OutlineColor = Color3.fromRGB(255, 0, 0)
                        h.OutlineTransparency = 0.3
                        h.Parent = parentModel
                        espHighlights[parentModel] = h
                        
                        local billboard = Instance.new("BillboardGui")
                        billboard.Size = UDim2.new(0, 200, 0, 25)
                        billboard.AlwaysOnTop = true
                        billboard.MaxDistance = 500
                        billboard.Parent = rootPart
                        
                        local label = Instance.new("TextLabel")
                        label.Size = UDim2.new(1, 0, 1, 0)
                        label.BackgroundTransparency = 1
                        label.Text = "NoriMonster"
                        label.TextColor3 = Color3.fromRGB(255, 0, 0)
                        label.Font = Enum.Font.GothamBold
                        label.TextSize = 14
                        label.TextStrokeTransparency = 0.5
                        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                        label.Parent = billboard
                        
                        espNameTags[parentModel] = billboard
                        espTargets[parentModel] = {
                            RootPart = rootPart,
                            Name = "NoriMonster",
                        }
                        
                        if characterRoot then
                            local dist = (characterRoot.Position - rootPart.Position).Magnitude
                            label.Text = "NoriMonster [" .. math.floor(dist) .. "米]"
                        end
                    end
                end
            end
        end
    end
end

-- ESP循环
RunService.Heartbeat:Connect(function()
    if Settings.NoriMonsterESP then
        local currentTime = tick()
        if currentTime - lastESPScan > 2 then
            updateESP()
            lastESPScan = currentTime
        end
        
        local character = LocalPlayer.Character
        local characterRoot = character and character:FindFirstChild("HumanoidRootPart")
        
        if characterRoot then
            for obj, billboard in pairs(espNameTags) do
                local target = espTargets[obj]
                if target and billboard and billboard.Parent and target.RootPart and target.RootPart.Parent then
                    local label = billboard:FindFirstChild("TextLabel")
                    if label then
                        local dist = (characterRoot.Position - target.RootPart.Position).Magnitude
                        label.Text = target.Name .. " [" .. math.floor(dist) .. "米]"
                    end
                else
                    if espHighlights[obj] then pcall(function() espHighlights[obj]:Destroy() end); espHighlights[obj] = nil end
                    if espNameTags[obj] then pcall(function() espNameTags[obj]:Destroy() end); espNameTags[obj] = nil end
                    espTargets[obj] = nil
                end
            end
        end
    else
        if next(espHighlights) then clearESP() end
    end
end)

-- 传送函数
local function teleportTo(pos, name)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        WindUI:Notify({Title = "传送失败", Content = "角色未加载", Duration = 2})
        return false
    end
    
    character.HumanoidRootPart.CFrame = CFrame.new(pos)
    WindUI:Notify({Title = "传送成功", Content = "已传送到" .. name, Duration = 2})
    return true
end

-- 传送到稻谷
local function teleportToRicePlants()
    local found = false
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name and obj.Name:lower():find("riceplant") then
            local rootPart = getRoot(obj)
            if rootPart and rootPart:IsA("BasePart") then
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(rootPart.Position + Vector3.new(0, 5, 0))
                    WindUI:Notify({Title = "传送成功", Content = "已传送到稻谷", Duration = 2})
                    found = true
                    break
                end
            end
        end
    end
    
    if not found then
        WindUI:Notify({Title = "未找到", Content = "找不到RicePlants", Duration = 2})
    end
end

-- 获取函数
local function getItem(pos, name)
    if isGetting then return end
    isGetting = true
    
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        isGetting = false
        return
    end
    
    local rootPart = character.HumanoidRootPart
    local originalPos = rootPart.Position
    
    rootPart.CFrame = CFrame.new(pos)
    WindUI:Notify({Title = "已传送", Content = "请自己拾取" .. name .. "\n3秒后自动返回", Duration = 3})
    
    task.wait(3)
    
    rootPart.CFrame = CFrame.new(originalPos)
    WindUI:Notify({Title = "已返回", Content = "已回到原位置", Duration = 2})
    isGetting = false
end

