-- ============ 普通版执行函数 ============
local function executeNormal()
    local loading = Instance.new("TextLabel")
    loading.Size = UDim2.new(1, -40, 0, 30)
    loading.Position = UDim2.new(0, 20, 0, 250)
    loading.BackgroundTransparency = 1
    loading.Text = "⏳ 正在加载普通版..."
    loading.TextColor3 = Color3.fromRGB(100, 200, 255)
    loading.Font = Enum.Font.GothamBold
    loading.TextSize = 14
    loading.TextXAlignment = Enum.TextXAlignment.Center
    loading.ZIndex = 13
    loading.Parent = Content
    
    NormalBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    NormalBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
    NormalBtn.AutoButtonColor = false
    AdminBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    AdminBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
    AdminBtn.AutoButtonColor = false
    CancelBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    CancelBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
    CancelBtn.AutoButtonColor = false
    
    task.spawn(function()
        pcall(function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/hgvuyguyg/jjjjjjjjj/main/黑脚本1.5"))()
        end)
        loading.Text = "✅ 普通版已执行！"
        loading.TextColor3 = Color3.fromRGB(100, 255, 100)
        wait(1.5)
        ScreenGui:Destroy()
    end)
end

