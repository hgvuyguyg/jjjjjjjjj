T2:Button({Title = "执行售卖一次", Justify = "Center", Callback = function() sellOnce() end})

T2:Section({Title = "自动买工人"})
T2:Toggle({Title = "开启自动买工人", Value = false, Callback = function(v) autoBuyWorker = v end})
T2:Slider({Title = "购买间隔(秒)", Value = {Min = 0.5, Max = 10, Default = 1}, Step = 0.5, Callback = function(v) workerInterval = v end})

T2:Section({Title = "防减速"})
T2:Toggle({Title = "果冻上不减速", Value = false, Callback = function(v) antiSlow = v end})

local T3 = Window:Tab({Title = "设置", Icon = "solar:settings-bold"})
local statusParagraph = T3:Paragraph({Title = "功能状态", Desc = "加载中..."})

spawn(function()
    while true do
        pcall(function()
            local fps = math.floor(1 / (RunService.RenderStepped:Wait() or 0.016))
            local status = "FPS: " .. fps .. "\n\n" ..
                "刷钱: " .. (autoFarm and "✅ " .. farmType or "❌") .. "\n" ..
                "买工人: " .. (autoBuyWorker and "✅" or "❌") .. "\n" ..
                "防减速: " .. (antiSlow and "✅" or "❌")
            statusParagraph:SetDesc(status)
        end)
        task.wait(0.5)
    end
end)

T3:Button({Title = "关闭面板", Justify = "Center", Callback = function() Window:Close() end})

WI:Notify({Title = "🌙 开箱ASMR", Content = "加载完成 | 5种刷钱", Duration = 3})
print("🌙 开箱ASMR 加载完成")
