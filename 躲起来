        local ev = ReplicatedStorage["ffrostflame_bridgenet2@1.0.0"].dataRemoteEvent
        ev:FireServer({
            Vector3.new(0.78280889987946, 6.1513269145053e-08, -0.62226217985153),
            "\x1B"
        })
    end)
end

