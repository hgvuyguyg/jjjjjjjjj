local WI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()
if not WI then return end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Settings = {
    ESP_Enabled = false,
    ESP_ShowHidden = false,
    WalkSpeed = 16,
    AutoEvade = false,
}

local VERSION = "v1.7"
local espTags = {}
local lastTeleport = 0

-- 清除ESP
local function clearESP()
    for _, tag in pairs(espTags) do
        pcall(function() tag:Destroy() end)
    end
    table.clear(espTags)
end

-- 创建名字标签
local function createTag(player)
    local bg = Instance.new("BillboardGui")
    bg.Name = "ESP"
    bg.Size = UDim2.new(0, 120, 0, 25)
    bg.AlwaysOnTop = true
    bg.MaxDistance = math.huge
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = player.Name
    label.TextColor3 = Color3.fromRGB(255, 80, 80)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.TextStrokeTransparency = 0.5
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.Parent = bg
    
    return bg
end

-- ESP更新
RunService.Heartbeat:Connect(function()
    if not Settings.ESP_Enabled then
        clearESP()
        return
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then
            if espTags[player] then
                pcall(function() espTags[player]:Destroy() end)
                espTags[player] = nil
            end
        else
            local char = player.Character
            if char and char:FindFirstChild("Head") then
                if Settings.ESP_ShowHidden then
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") and part.Transparency > 0.5 then
                            part.Transparency = 0.5
                        end
                    end
                end
                
                if not espTags[player] then
                    espTags[player] = createTag(player)
                end
                if espTags[player] and espTags[player].Parent ~= char.Head then
                    espTags[player].Parent = char.Head
                end
            else
                if espTags[player] then
                    pcall(function() espTags[player]:Destroy() end)
                    espTags[player] = nil
                end
            end
        end
    end
end)

-- 玩家离开时清理
Players.PlayerRemoving:Connect(function(player)
    if espTags[player] then
        pcall(function() espTags[player]:Destroy() end)
        espTags[player] = nil
    end
end)

-- 判断杀手
local function isKiller(player)
    local char = player.Character
    if not char then return false end
    for _, obj in pairs(char:GetChildren()) do
        if obj:IsA("Tool") then
            local n = obj.Name:lower()
            if n:find("knife") or n:find("sword") or n:find("weapon") then
                return true
            end
        end
    end
    return false
end

-- 自动避杀手
local function avoidKiller()
    if not Settings.AutoEvade then return end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    for _, plr in pairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if not isKiller(plr) then continue end
        
        local tc = plr.Character
        if not tc then continue end
        local tr = tc:FindFirstChild("HumanoidRootPart")
        if not tr then continue end
        
        local dist = (root.Position - tr.Position).Magnitude
        if dist < 20 and tick() - lastTeleport > 3 then
            local dir = (root.Position - tr.Position).Unit
            root.CFrame = CFrame.new(root.Position + dir * 100)
            lastTeleport = tick()
        end
    end
end

RunService.Heartbeat:Connect(avoidKiller)

-- 速度
local function setSpeed(s)
    local c = LocalPlayer.Character
    if c and c:FindFirstChild("Humanoid") then
        c.Humanoid.WalkSpeed = s
    end
end

-- 小鸡
local function spawnChicken()
