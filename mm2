    -- UI风格
    UI_Acrylic = true
}

-- 角色分类
local function GetPlayerRole(player)
    local character = player.Character
    if not character then return "Unknown" end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return "Unknown" end
    
    return "Civilian" -- 默认返回平民，实际需根据游戏机制修改
end

local function GetRoleColor(role)
    if role == "Killer" then
        return Settings.ESP_BoxColor_Killer
    elseif role == "Agent" then
        return Settings.ESP_BoxColor_Agent
    else
        return Settings.ESP_BoxColor_Civilian
    end
end

-- 透视绘制
local function CreateESP()
    local drawings = {}
    
    local function UpdateESP()
        -- 清除旧绘图
        for _, d in pairs(drawings) do
            if d then d:Remove() end
        end
        table.clear(drawings)
        
        if not Settings.ESP_Enabled then return end
        
        for _, player in pairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            local character = player.Character
            if not character or not character:FindFirstChild("HumanoidRootPart") then continue end
            if character:FindFirstChild("Humanoid") and character.Humanoid.Health <= 0 then continue end
            
            local role = GetPlayerRole(player)
            
            -- 团队检查
            if Settings.ESP_TeamCheck and role == GetPlayerRole(LocalPlayer) then
                continue
            end
            
            -- 角色过滤
            if role == "Killer" and not Settings.ESP_ShowKiller then continue end
            if role == "Civilian" and not Settings.ESP_ShowCivilian then continue end
            if role == "Agent" and not Settings.ESP_ShowAgent then continue end
            
            local targetPart = character:FindFirstChild(Settings.ESP_TargetPart) or character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
            if not targetPart then continue end
            
            local position, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
            if not onScreen then continue end
            
            local color = GetRoleColor(role)
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            local head = character:FindFirstChild("Head")
            
            -- 显示方框
            if Settings.ESP_ShowBox and rootPart and head then
                local rootPos, rootVisible = Camera:WorldToViewportPoint(rootPart.Position)
                local headPos, headVisible = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                if rootVisible and headVisible then
                    local boxHeight = math.abs(headPos.Y - rootPos.Y)
                    local boxWidth = boxHeight * 0.65
                    
                    local boxOutline = Drawing.new("Square")
                    boxOutline.Position = Vector2.new(headPos.X - boxWidth/2 - 1, headPos.Y - 1)
                    boxOutline.Size = Vector2.new(boxWidth + 2, boxHeight + 2)
                    boxOutline.Color = Color3.new(0,0,0)
                    boxOutline.Filled = false
                    boxOutline.Thickness = 3
                    boxOutline.Visible = true
                    table.insert(drawings, boxOutline)
                    
                    local box = Drawing.new("Square")
                    box.Position = Vector2.new(headPos.X - boxWidth/2, headPos.Y)
                    box.Size = Vector2.new(boxWidth, boxHeight)
                    box.Color = color
                    box.Filled = false
                    box.Thickness = 1.5
                    box.Visible = true
                    table.insert(drawings, box)
                end
            end
            
            -- 显示名字
            if Settings.ESP_ShowName then
                local nameLabel = Drawing.new("Text")
                nameLabel.Text = player.Name
                nameLabel.Size = 14
                nameLabel.Position = Vector2.new(position.X, position.Y - 40)
                nameLabel.Color = Color3.new(255,255,255)
                nameLabel.Outline = false
                nameLabel.Center = true
                nameLabel.Visible = true
                table.insert(drawings, nameLabel)
            end
            
            -- 显示职业
            if Settings.ESP_ShowRole then
                local roleLabel = Drawing.new("Text")
                roleLabel.Text = role
                roleLabel.Size = 13
                roleLabel.Position = Vector2.new(position.X, position.Y - 25)
                roleLabel.Color = color
                roleLabel.Outline = false
                roleLabel.Center = true
                roleLabel.Visible = true
                table.insert(drawings, roleLabel)
            end
            
            -- 显示血量
            if Settings.ESP_ShowHealth and character:FindFirstChild("Humanoid") then
                local health = character.Humanoid.Health
                local maxHealth = character.Humanoid.MaxHealth
                local healthPercent = math.floor((health / maxHealth) * 100)
                
                local healthBar = Drawing.new("Square")
                healthBar.Position = Vector2.new(position.X - 25, position.Y - 10)
                healthBar.Size = Vector2.new(50, 4)
                healthBar.Color = Color3.new(0,0,0)
                healthBar.Filled = true
                healthBar.Visible = true
                table.insert(drawings, healthBar)
                
                local healthFill = Drawing.new("Square")
                healthFill.Position = Vector2.new(position.X - 25, position.Y - 10)
                healthFill.Size = Vector2.new(50 * (healthPercent / 100), 4)
                healthFill.Color = healthPercent > 50 and Color3.new(50,255,50) or (healthPercent > 25 and Color3.new(255,255,50) or Color3.new(255,50,50))
                healthFill.Filled = true
                healthFill.Visible = true
                table.insert(drawings, healthFill)
                
                local healthText = Drawing.new("Text")
                healthText.Text = healthPercent .. "%"
                healthText.Size = 12
                healthText.Position = Vector2.new(position.X, position.Y - 10)
                healthText.Color = Color3.new(255,255,255)
                healthText.Outline = false
                healthText.Center = true
                healthText.Visible = true
                table.insert(drawings, healthText)
            end
            
            -- 显示距离
            if Settings.ESP_ShowDistance and rootPart and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local distance = (rootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
                local distLabel = Drawing.new("Text")
                distLabel.Text = math.floor(distance) .. "m"
                distLabel.Size = 12
                distLabel.Position = Vector2.new(position.X, position.Y + 20)
                distLabel.Color = Color3.new(255,255,255)
                distLabel.Outline = false
                distLabel.Center = true
                distLabel.Visible = true
                table.insert(drawings, distLabel)
            end
            
            -- 显示追踪线
            if Settings.ESP_ShowTracer then
                local line = Drawing.new("Line")
                line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                line.To = Vector2.new(position.X, position.Y)
                line.Color = color
                line.Thickness = 1
                line.Transparency = 0.7
                line.Visible = true
                table.insert(drawings, line)
            end
        end
    end
    
    RunService.RenderStepped:Connect(UpdateESP)
end

