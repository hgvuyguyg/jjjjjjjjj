-- 零售大亨2 脚本 v1.8
-- WindUI版 | 自动收垃圾+收货放家合并 | 传送玩家 | 透视 | 调速度
local WI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()
if not WI then return end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local LocalPlayer = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Settings = {
    AutoTrash = false,
    AutoDeliver = false,
    DoorNumber = "1",
    ESP_Enabled = false,
    WalkSpeed = 16,
}

local savedPositions = { homePos = nil, trashPos = nil }
local VERSION = "v1.8"
local stopAll = false
local highlights = {}
local nameTags = {}

local doorPositions = {
    ["1"] = Vector3.new(1780, -83, -1950),
    ["2"] = Vector3.new(1785, -83, -1950),
    ["3"] = Vector3.new(1790, -83, -1950),
    ["4"] = Vector3.new(1795, -83, -1950),
    ["5"] = Vector3.new(1800, -83, -1950),
    ["6"] = Vector3.new(1805, -83, -1950),
}

local function getPos()
    local c = LocalPlayer.Character
    if c and c:FindFirstChild("HumanoidRootPart") then return c.HumanoidRootPart.Position end
    return nil
end

local function tp(pos)
    local c = LocalPlayer.Character
    if c and c:FindFirstChild("HumanoidRootPart") then
        c.HumanoidRootPart.CFrame = CFrame.new(pos)
    end
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("VehicleSeat") and v.Occupant then
            local car = v.Parent
            if car and car:IsA("Model") and car:FindFirstChild("PrimaryPart") then
                car:SetPrimaryPartCFrame(CFrame.new(pos + Vector3.new(0, 5, 0)))
            end
            break
        end
    end
end

local function holdE(duration)
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, nil)
    task.wait(duration)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, nil)
end

-- 自动收垃圾
task.spawn(function()
    while true do
        if Settings.AutoTrash and not stopAll then
            if not savedPositions.trashPos then task.wait(1) continue end
            task.wait(60)
            if not Settings.AutoTrash or stopAll then continue end
            local returnPos = getPos()
            if not returnPos then continue end
            tp(savedPositions.trashPos)
            task.wait(0.5)
            holdE(3)
            task.wait(0.3)
            tp(returnPos)
        else
            task.wait(1)
        end
    end
end)

-- 自动收货放家
task.spawn(function()
    while true do
        if Settings.AutoDeliver and not stopAll then
            if not savedPositions.homePos then task.wait(1) continue end
            local doorPos = doorPositions[Settings.DoorNumber]
            if doorPos then
                tp(doorPos)
                task.wait(1)
            end
            pcall(function() ReplicatedStorage.Remotes.LoadVehicle:InvokeServer() end)
            task.wait(0.5)
            tp(savedPositions.homePos)
            task.wait(10)
        else
            task.wait(1)
        end
    end
end)

-- ESP
local function clearESP()
    for _, h in pairs(highlights) do pcall(function() h:Destroy() end) end
    for _, t in pairs(nameTags) do pcall(function() t:Destroy() end) end
    table.clear(highlights)
    table.clear(nameTags)
end

RunService.Heartbeat:Connect(function()
    if not Settings.ESP_Enabled then clearESP() return end
    for _, plr in pairs(Players:GetPlayers()) do
        if plr == LocalPlayer then
            if highlights[plr] then pcall(function() highlights[plr]:Destroy() end) highlights[plr] = nil end
            if nameTags[plr] then pcall(function() nameTags[plr]:Destroy() end) nameTags[plr] = nil end
        else
            local char = plr.Character
            if char and char:FindFirstChild("Head") then
                if not highlights[plr] then
                    local h = Instance.new("Highlight")
                    h.FillColor = Color3.fromRGB(255, 100, 100); h.FillTransparency = 0.5
                    h.OutlineColor = Color3.fromRGB(255, 50, 50); h.OutlineTransparency = 0.3
                    highlights[plr] = h
                end
                if highlights[plr] and highlights[plr].Parent ~= char then highlights[plr].Parent = char end
                if not nameTags[plr] then
                    local bg = Instance.new("BillboardGui")
                    bg.Size = UDim2.new(0, 120, 0, 25); bg.AlwaysOnTop = true; bg.MaxDistance = math.huge
                    local l = Instance.new("TextLabel")
                    l.Size = UDim2.new(1, 0, 1, 0); l.BackgroundTransparency = 1
                    l.Text = plr.Name; l.TextColor3 = Color3.fromRGB(255, 255, 255)
                    l.Font = Enum.Font.GothamBold; l.TextSize = 14
                    l.TextStrokeTransparency = 0.5; l.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                    l.Parent = bg
                    nameTags[plr] = bg
                end
                if nameTags[plr] and nameTags[plr].Parent ~= char.Head then nameTags[plr].Parent = char.Head end
            end
        end
    end
end)

Players.PlayerRemoving:Connect(function(plr)
    if highlights[plr] then pcall(function() highlights[plr]:Destroy() end) highlights[plr] = nil end
    if nameTags[plr] then pcall(function() nameTags[plr]:Destroy() end) nameTags[plr] = nil end
end)

local function setSpeed(s)
    local c = LocalPlayer.Character
    if c and c:FindFirstChild("Humanoid") then c.Humanoid.WalkSpeed = s end
end

RunService.Heartbeat:Connect(function()
    if Settings.WalkSpeed ~= 16 then setSpeed(Settings.WalkSpeed) end
end)

local function locateHome()
    local p = getPos()
    if p then savedPositions.homePos = p end
    WI:Notify({Title = "成功", Content = "家位置已定位", Duration = 1})
end

local function locateTrash()
    local p = getPos()
    if p then savedPositions.trashPos = p end
    WI:Notify({Title = "成功", Content = "垃圾桶已定位", Duration = 1})
end

local function clearAll()
    savedPositions.homePos = nil
    savedPositions.trashPos = nil
    WI:Notify({Title = "清除", Content = "所有定位已清除", Duration = 1})
end

local function getPlayerNames()
    local names = {}
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then table.insert(names, plr.Name) end
    end
    if #names == 0 then table.insert(names, "无其他玩家") end
    return names
end

-- UI
local Win = WI:CreateWindow({
    Title = "零售大亨2", Icon = "solar:cart-bold",
    Size = UDim2.fromOffset(400, 480), Acrylic = true,
})

Win:Tab({Title = "公告", Icon = "solar:home-bold"}):Paragraph({
    Title = "黑脚本--功能说明", Desc = "自动收垃圾(定位垃圾桶)\n自动收货放家(到家自己卸货)\n透视 | 调速度\n\n版本：" .. VERSION
})

-- 主要
local t1 = Win:Tab({Title = "主要", Icon = "solar:play-bold"})
t1:Toggle({Title = "自动收垃圾", Value = false, Callback = function(v) Settings.AutoTrash = v end})
t1:Paragraph({Title = "说明", Desc = "每1分钟传到垃圾桶→长按E 3秒→传回原地"})
t1:Divider()
t1:Dropdown({Title = "选择门号", Values = {"1","2","3","4","5","6"}, Value = "1", Callback = function(v) Settings.DoorNumber = v end})
t1:Divider()
t1:Toggle({Title = "自动收货放家", Value = false, Callback = function(v) Settings.AutoDeliver = v if v and not savedPositions.homePos then WI:Notify({Title="错误", Content="请先定位家位置！", Duration=3}) Settings.AutoDeliver = false end end})
t1:Paragraph({Title = "说明", Desc = "传到选中门→LoadVehicle→传回家\n到家后需要自己点卸货"})

-- 定位
local t2 = Win:Tab({Title = "定位", Icon = "solar:map-point-bold"})
t2:Button({Title = "定位家位置", Justify = "Center", Color = Color3.fromHex("#4CAF50"), Callback = locateHome})
t2:Divider()
t2:Button({Title = "定位垃圾桶", Justify = "Center", Color = Color3.fromHex("#FF9800"), Callback = locateTrash})
t2:Divider()
t2:Button({Title = "清除所有定位", Justify = "Center", Color = Color3.fromHex("#ff4444"), Callback = clearAll})

-- 玩家
local t4 = Win:Tab({Title = "玩家", Icon = "solar:user-bold"})
t4:Toggle({Title = "开启透视", Value = false, Callback = function(v) Settings.ESP_Enabled = v if not v then clearESP() end end})
t4:Divider()
t4:Input({Title = "移动速度", Value = "16", Callback = function(v) local n = tonumber(v) if n and n >= 10 and n <= 100 then Settings.WalkSpeed = n end end})
t4:Divider()
t4:Button({Title = "重置速度", Justify = "Center", Color = Color3.fromHex("#888888"), Callback = function() Settings.WalkSpeed = 16 end})

-- 设置
Win:Tab({Title = "设置", Icon = "solar:settings-bold"}):Button({
    Title = "关闭脚本", Justify = "Center", Color = Color3.fromHex("#ff4444"),
    Callback = function() stopAll = true Settings.AutoTrash = false Settings.AutoDeliver = false Settings.ESP_Enabled = false clearESP() setSpeed(16) pcall(function() local g = game:GetService("CoreGui"):FindFirstChild("WindUI") if g then g:Destroy() end end) end
})

WI:Notify({Title = "零售大亨2", Content = VERSION .. " 加载完成", Duration = 5})
