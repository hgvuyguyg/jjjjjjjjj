    table.clear(cachedJerrycans)
end

-- 物品ESP循环
RunService.Heartbeat:Connect(function()
    if not Settings.ItemESPEnabled then
        if next(itemHighlights) then clearItemESP() end
        return
    end
    
    local currentTime = tick()
    if currentTime - lastItemScan > 3 then
        cachedItems = getAllItems()
        lastItemScan = currentTime
        
        -- 清理无效高亮
        local activeItems = {}
        for _, item in pairs(cachedItems) do activeItems[item.Object] = true end
        for obj, _ in pairs(itemHighlights) do
            if not activeItems[obj] then
                if itemHighlights[obj] then pcall(function() itemHighlights[obj]:Destroy() end); itemHighlights[obj] = nil end
                if itemNameTags[obj] then pcall(function() itemNameTags[obj]:Destroy() end); itemNameTags[obj] = nil end
            end
        end
        
        -- 创建新高亮
        for _, item in pairs(cachedItems) do
            if item.Object and item.Object.Parent then
                if not itemHighlights[item.Object] then
                    local h = Instance.new("Highlight")
                    h.FillColor = Settings.ESPColor
                    h.FillTransparency = 0.5
                    h.OutlineColor = Settings.ESPColor
                    h.OutlineTransparency = 0.3
                    h.Parent = item.Object
                    itemHighlights[item.Object] = h
                    
                    local dist = ""
                    if Settings.ItemESPShowDistance then
                        local d = 0
                        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            d = (item.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
                        end
                        dist = "\n[" .. math.floor(d) .. "m]"
                    end
                    
                    local bg = Instance.new("BillboardGui")
                    bg.Size = UDim2.new(0, 200, 0, 40)
                    bg.AlwaysOnTop = true
                    bg.MaxDistance = math.huge
                    bg.Parent = item.RootPart
                    
                    local l = Instance.new("TextLabel")
                    l.Size = UDim2.new(1, 0, 1, 0)
                    l.BackgroundTransparency = 1
                    l.Text = getItemChineseName(item.Object.Name) .. dist
                    l.TextColor3 = Settings.ESPColor
                    l.Font = Enum.Font.GothamBold
                    l.TextSize = 14
                    l.TextStrokeTransparency = 0.5
                    l.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                    l.Parent = bg
                    itemNameTags[item.Object] = bg
                end
            end
        end
    end
end)

