    Value = {Min = 16, Max = 500, Default = 100},
    Step = 1,
    Callback = function(speed)
        Settings.SpeedValue = speed
        if Settings.SpeedEnabled then setSpeed() end
    end
})

PlayerTab:Divider()

PlayerTab:Button({
    Title = "飞行",
    Callback = function()
        loadFlyScript()
        Settings.FlyEnabled = true
        WindUI:Notify({Title = "飞行已加载", Content = "使用飞行脚本", Duration = 3})
    end
})

PlayerTab:Divider()

PlayerTab:Button({
    Title = "传送到最近油桶",
    Callback = function()
        teleportToNearestJerrycan()
    end
})

-- 设置
local SettingsTab = Window:Tab({Title = "设置", Icon = "solar:settings-bold"})

local statusParagraph = SettingsTab:Paragraph({
    Title = "功能状态",
    Desc = "正在加载..."
})

local function updateStatus()
    local status = ""
    
    if mtHook then
        status = status .. "✅ 绕过反作弊: 已开启\n"
    else
        status = status .. "❌ 绕过反作弊: 未开启\n"
    end
    
    if Settings.KillAuraEnabled then
        status = status .. "✅ 杀戮光环: 已开启 (伤害: " .. Settings.KillDamage .. ")\n"
    else
        status = status .. "❌ 杀戮光环: 未开启\n"
    end
    
    if Settings.ItemESPEnabled then
        status = status .. "✅ 物品透视: 已开启 (" .. #cachedItems .. "个物品)\n"
    else
        status = status .. "❌ 物品透视: 未开启\n"
    end
    
    if Settings.NPCESPEnabled then
        status = status .. "✅ NPC透视: 已开启 (" .. #cachedNPCs .. "个NPC)\n"
    else
        status = status .. "❌ NPC透视: 未开启\n"
    end
    
    if Settings.JerrycanESPEnabled then
        status = status .. "✅ 油桶透视: 已开启 (" .. #cachedJerrycans .. "个油桶)\n"
    else
        status = status .. "❌ 油桶透视: 未开启\n"
    end
    
    if Settings.SpeedEnabled then
        status = status .. "✅ 调整速度: 已开启 (" .. Settings.SpeedValue .. ")\n"
    else
        status = status .. "❌ 调整速度: 未开启\n"
    end
    
    statusParagraph:SetDesc(status)
end

RunService.Heartbeat:Connect(function()
    updateStatus()
end)

SettingsTab:Button({
    Title = "关闭面板",
    Callback = function()
        Window:Close()
    end
})

Window:OnClose(function()
    -- 不关闭功能，只关闭面板
end)

WindUI:Notify({
    Title = "逃跑者",
    Content = VERSION .. " 加载完成",
    Duration = 3
})
