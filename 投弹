-- 🌙 偷一个蛋

local WI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()
if not WI then return end

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

-- 变量
local autoSteal = false
local speedBoost = false
local speedValue = 50
local flySpeed = 200
local stealWaitTime = 2 -- 自定义等待时间

-- ==================== 冰白主题 ====================
WI:AddTheme({
    Name = "冰白",
    Accent = "#80C0FF",
    Outline = "#6090C0",
    Text = "#FFFFFF",
    Placeholder = "#D0E0FF"
})

-- ==================== 速度 ====================
RunService.RenderStepped:Connect(function()
    if speedBoost then
        pcall(function()
            local c = LocalPlayer.Character
            if c and c:FindFirstChild("Humanoid") then
                c.Humanoid.WalkSpeed = speedValue
            end
        end)
    end
end)

-- ==================== 等待角色加载 ====================
local function waitForCharacter(timeout)
    timeout = timeout or 10
    local startTime = tick()
    while tick() - startTime < timeout do
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
            local hrp = char.HumanoidRootPart
            local hum = char.Humanoid
            if hrp and hum and hum.Health > 0 then
                return true
            end
        end
        task.wait(0.2)
    end
    return false
end

-- ==================== 安全飞行 ====================
local function safeFlyTo(targetPos)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    local hrp = char.HumanoidRootPart

    local liftPos = hrp.Position + Vector3.new(0, 5, 0)
    local liftDuration = 5 / flySpeed
    if liftDuration < 0.1 then liftDuration = 0.1 end
    local liftTween = TweenService:Create(hrp, TweenInfo.new(liftDuration, Enum.EasingStyle.Linear), {CFrame = CFrame.new(liftPos)})
    liftTween:Play()
    liftTween.Completed:Wait()
    task.wait(0.3)

    local startPos = hrp.Position
    local distance = (targetPos - startPos).Magnitude
    local duration = distance / flySpeed
    if duration < 0.1 then duration = 0.1 end
    local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
    tween:Play()
    tween.Completed:Wait()
    task.wait(0.3)

    local finalDuration = 5 / flySpeed
    if finalDuration < 0.1 then finalDuration = 0.1 end
    local finalTween = TweenService:Create(hrp, TweenInfo.new(finalDuration, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
    finalTween:Play()
    finalTween.Completed:Wait()
    return true
end

-- ==================== 传送最后端 ====================
local function teleportToEnd()
    if not waitForCharacter(5) then
        WI:Notify({Title = "传送失败", Content = "角色未加载", Duration = 2})
        return
    end
    safeFlyTo(Vector3.new(3439, 70.7, -337))
    WI:Notify({Title = "传送成功", Content = "已到最后端", Duration = 2})
end

-- ==================== 半自动偷蛋 ====================
spawn(function()
    while true do
        if autoSteal then
            pcall(function()
                if not waitForCharacter(10) then
                    WI:Notify({Title = "偷蛋", Content = "角色加载超时", Duration = 3})
                    autoSteal = false
                    return
                end

                WI:Notify({Title = "偷蛋", Content = "开始飞行", Duration = 2})

                -- 1. 飞到偷蛋位置
                local success = safeFlyTo(Vector3.new(3394, 70.7, -326))
                if not success then
                    autoSteal = false
                    return
                end
                WI:Notify({Title = "偷蛋", Content = "已到达，等待" .. stealWaitTime .. "秒", Duration = 2})

                -- 2. 等待自定义时间
                task.wait(stealWaitTime)

                -- 3. 飞回安全位置
                safeFlyTo(Vector3.new(518, 70.7, -354))
                WI:Notify({Title = "偷蛋", Content = "已飞回安全位置", Duration = 2})

                autoSteal = false
            end)
        end
        task.wait(0.3)
    end
end)

