local function getPos()
    local c = LocalPlayer.Character
    if c and c:FindFirstChild("HumanoidRootPart") then return c.HumanoidRootPart.Position end
    return nil
end

local function tp(pos)
    local c = LocalPlayer.Character
    if not c then return end
    local root = c:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if pos.Y < -100 or pos.Y > 5000 then return end
    root.CFrame = CFrame.new(pos)
end

local function clearAll()
    for _, obj in pairs(workspace:GetDescendants()) do
        if (obj:IsA("Highlight") and obj.Name == "ESP_HL") or (obj:IsA("BillboardGui") and obj.Name == "ESP_Tag") then
            pcall(function() obj:Destroy() end)
        end
    end
end

local function isPlayerModel(model)
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Character == model then return true end
        if plr.Character and model:IsDescendantOf(plr.Character) then return true end
    end
    return false
end

local function classifyModel(model)
    local name = model.Name:lower()
    local hum = model:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then
        if name == "scrap" then return "scrap", "废料" end
        for key, label in pairs(buildingNameMap) do
            if model.Name == key then return "building", label end
        end
        return nil, nil
    end
    -- 精确匹配动物名
    for aName, aLabel in pairs(animalNameMap) do
        if name == aName then return "animal", aLabel end
    end
    -- 包含匹配动物名
    for _, aName in ipairs(animalNames) do
        if name:find(aName) then return "animal", animalNameMap[aName] or "动物" end
    end
    for _, mName in ipairs(monsterNames) do if name:find(mName) then return "monster", "怪物" end end
    return nil, nil
end

local function deduplicateBuildings(buildings)
    local result = {}
    local myPos = getPos()
    if not myPos then return buildings end
    
    table.sort(buildings, function(a, b)
        local pa = a:IsA("Model") and (a:FindFirstChildWhichIsA("BasePart") or a.PrimaryPart) or a
        local pb = b:IsA("Model") and (b:FindFirstChildWhichIsA("BasePart") or b.PrimaryPart) or b
        local da = pa and (myPos - pa.Position).Magnitude or 9999
        local db = pb and (myPos - pb.Position).Magnitude or 9999
        return da < db
    end)
    
    for _, obj in ipairs(buildings) do
        local labelName = buildingNameMap[obj.Name]
        if labelName then
            local part = obj:IsA("Model") and (obj:FindFirstChildWhichIsA("BasePart") or obj.PrimaryPart) or obj
            if part then
                local tooClose = false
                for _, existing in ipairs(result) do
                    local existingName = buildingNameMap[existing.Name]
                    if existingName == labelName then
                        local existingPart = existing:IsA("Model") and (existing:FindFirstChildWhichIsA("BasePart") or existing.PrimaryPart) or existing
                        if existingPart and (existingPart.Position - part.Position).Magnitude < 20 then
                            tooClose = true; break
                        end
                    end
                end
                if not tooClose then table.insert(result, obj) end
            end
        else
            table.insert(result, obj)
        end
    end
    return result
end

local function addESP(obj, objType, labelName, part)
    local color
    if objType == "animal" then color = Color3.fromRGB(255, 200, 50)
    elseif objType == "monster" then color = Color3.fromRGB(255, 80, 80)
    elseif objType == "building" then color = Color3.fromRGB(100, 200, 255)
    elseif objType == "scrap" then color = Color3.fromRGB(180, 180, 180)
    elseif objType == "player" then color = Color3.fromRGB(70, 255, 70)
    end
    
    if not obj:FindFirstChild("ESP_HL") then
        local h = Instance.new("Highlight")
        h.Name = "ESP_HL"; h.FillColor = color; h.FillTransparency = 0.4
        h.OutlineColor = color; h.OutlineTransparency = 0.2
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; h.Parent = obj
    end
    
    if part and not part:FindFirstChild("ESP_Tag") then
        local bg = Instance.new("BillboardGui")
        bg.Name = "ESP_Tag"; bg.Size = UDim2.new(0, 150, 0, 30)
        bg.AlwaysOnTop = true; bg.MaxDistance = math.huge; bg.Parent = part
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0); label.BackgroundTransparency = 1
        label.Text = labelName; label.TextColor3 = color
        label.Font = Enum.Font.GothamBold; label.TextSize = 14
        label.TextStrokeTransparency = 0.5; label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        label.Parent = bg
    end
end

local function scanEverything()
    local allObjects = {}
    local buildings = {}
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if not obj:IsA("Model") and not obj:IsA("BasePart") then continue end
        if isPlayerModel(obj) then continue end
        local objType, labelName = classifyModel(obj)
        if not objType then continue end
        if objType == "building" then table.insert(buildings, obj)
        else table.insert(allObjects, {obj = obj, objType = objType, labelName = labelName}) end
    end
    
    buildings = deduplicateBuildings(buildings)
    for _, obj in ipairs(buildings) do
        local _, labelName = classifyModel(obj)
        table.insert(allObjects, {obj = obj, objType = "building", labelName = labelName})
    end
    
    -- 添加透视玩家
    if Settings.ESP_Player then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") then
                table.insert(allObjects, {obj = plr.Character, objType = "player", labelName = plr.Name})
            end
        end
    end
    
    for _, data in ipairs(allObjects) do
        if data.objType == "animal" and not Settings.ESP_Animal then continue end
        if data.objType == "monster" and not Settings.ESP_Monster then continue end
        if data.objType == "building" and not Settings.ESP_Building then continue end
        if data.objType == "scrap" and not Settings.ESP_Scrap then continue end
        if data.objType == "player" and not Settings.ESP_Player then continue end
        local part = data.obj:IsA("Model") and (data.obj:FindFirstChild("Head") or data.obj:FindFirstChild("HumanoidRootPart") or data.obj:FindFirstChildWhichIsA("BasePart") or data.obj.PrimaryPart) or data.obj
        if part then addESP(data.obj, data.objType, data.labelName, part) end
    end
end

-- ==================== 捡废料（按钮版） ====================
local function collectOneScrap()
    local c = LocalPlayer.Character
    if not c or not c:FindFirstChild("HumanoidRootPart") then
        WindUI:Notify({Title = "错误", Content = "角色未加载", Duration = 2})
        return
    end
    local myRoot = c.HumanoidRootPart
    local nearest = nil
    local nearestDist = math.huge
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            if obj.Name:lower() == "scrap" then
                local part = obj:IsA("Model") and (obj:FindFirstChildWhichIsA("BasePart") or obj.PrimaryPart) or obj
                if part and part.Position.Y > -50 and part.Position.Y < 3000 then
                    local dist = (myRoot.Position - part.Position).Magnitude
                    if dist < nearestDist and dist > 2 then
                        nearestDist = dist; nearest = part
                    end
                end
            end
        end
    end
    
    if nearest then
        tp(nearest.Position + Vector3.new(0, 3, 0))
        task.wait(0.3)
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, nil)
        task.wait(0.1)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, nil)
        WindUI:Notify({Title = "成功", Content = "已捡一个废料", Duration = 1})
    else
        WindUI:Notify({Title = "提示", Content = "已捡完所有废料！", Duration = 3})
    end
end

task.spawn(function() while true do scanEverything(); task.wait(3) end end)

task.spawn(function()
    while true do
        local c = LocalPlayer.Character
        if c and c:FindFirstChild("HumanoidRootPart") then
            local myRoot = c.HumanoidRootPart
            for _, tag in pairs(workspace:GetDescendants()) do
                if tag:IsA("BillboardGui") and tag.Name == "ESP_Tag" then
                    local label = tag:FindFirstChildWhichIsA("TextLabel")
                    local parent = tag.Parent
                    if label and parent then
                        local dist = (myRoot.Position - parent.Position).Magnitude
                        local baseName = label.Text:match("^(.-) %d")
                        if baseName then label.Text = baseName .. " " .. math.floor(dist) .. "m" end
                    end
                end
            end
        end
        task.wait(0.5)
    end
end)

