        clearAllESP() updateNightVision() setSpeed(16)
        pcall(function() local g = game:GetService("CoreGui"):FindFirstChild("WindUI") if g then g:Destroy() end end)
    end
})

WI:Notify({Title = "活了7天", Content = VERSION .. " 加载完成", Duration = 5})
