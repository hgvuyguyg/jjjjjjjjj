-- ==================== 全自动捡废料（全图扫描） ====================
task.spawn(function()
    while true do
        if Settings.AutoScrap and scrapUnlocked then
            local allScraps = getAllScraps()
            collectedCount = 0
            
            if #allScraps > 0 then
                WindUI:Notify({Title = "开始捡废料", Content = "全图扫描到 " .. #allScraps .. " 个废料", Duration = 2})
                
                for _, part in ipairs(allScraps) do
                    if not Settings.AutoScrap then break end
                    if not part or not part.Parent then continue end
                    
                    tp(part.Position + Vector3.new(0, 3, 0))
                    task.wait(0.15)
                    
                    -- 疯狂点F 3次确保捡到
                    for i = 1, 3 do
                        if not Settings.AutoScrap then break end
                        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, nil)
                        task.wait(0.05)
                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, nil)
                        task.wait(0.05)
                    end
                    
                    collectedCount = collectedCount + 1
                    task.wait(0.1)
                end
                
                WindUI:Notify({Title = "完成", Content = "本轮捡了 " .. collectedCount .. " / " .. #allScraps .. " 个废料", Duration = 3})
                Settings.AutoScrap = false
            else
                WindUI:Notify({Title = "提示", Content = "全图未找到任何废料", Duration = 2})
                Settings.AutoScrap = false
            end
            task.wait(0.5)
        else
            task.wait(1)
        end
    end
end)

task.spawn(function() while true do scanEverything(); task.wait(2) end end)

task.spawn(function()
    while true do
        local c = LocalPlayer.Character
        if c and c:FindFirstChild("HumanoidRootPart") then
            local myRoot = c.HumanoidRootPart
            for _, tag in pairs(workspace:GetDescendants()) do
                if tag:IsA("BillboardGui") and tag.Name == "ESP_Tag" then
                    local label = tag:FindFirstChildWhichIsA("TextLabel")
                    local parent = tag.Parent
                    if label and parent then
                        local dist = (myRoot.Position - parent.Position).Magnitude
                        local baseName = label.Text:match("^(.-) %d")
                        if baseName then label.Text = baseName .. " " .. math.floor(dist) .. "m" end
                    end
                end
            end
        end
        task.wait(0.5)
    end
end)

