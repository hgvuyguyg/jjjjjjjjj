-- 活了7天 脚本 v1.9
-- WindUI版 | 每30秒自动刷新透视 | 彻底修复
local WI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()
if not WI then return end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Lighting = game:GetService("Lighting")

local Settings = {
    ESP_Animal = false,
    ESP_Monster = false,
    ESP_Building = false,
    NightVision = false,
    WalkSpeed = 16,
}

local savedWaypoints = {}
local homePos = nil
local VERSION = "v1.9"
local stopAll = false
local espObjects = {}

local animalNames = {["moose"] = "驼鹿", ["boar"] = "野猪", ["bear"] = "熊", ["deer"] = "鹿"}
local monsterNames = {"cat", "wolf", "zombie", "spider", "snake", "monster", "enemy", "beast", "creature", "demon", "ghost", "skeleton", "dragon", "goblin", "troll", "orc"}
local buildingNames = {
    ["beacon_house"] = "培根小屋", ["Minecart"] = "矿车", ["witch_house"] = "女巫小屋",
    ["lost_key_shack"] = "失钥棚屋", ["abandoned_shack"] = "废弃棚屋", ["orbital_blocker"] = "轨道阻挡器",
}

local function tpHome()
    if not homePos then WI:Notify({Title = "错误", Content = "请先在传送页定位家！", Duration = 3}) return end
    local c = LocalPlayer.Character
    if c and c:FindFirstChild("HumanoidRootPart") then c.HumanoidRootPart.CFrame = CFrame.new(homePos) end
end

local function tp(pos)
    local c = LocalPlayer.Character
    if c and c:FindFirstChild("HumanoidRootPart") then c.HumanoidRootPart.CFrame = CFrame.new(pos) end
end

local function getPos()
    local c = LocalPlayer.Character
    if c and c:FindFirstChild("HumanoidRootPart") then return c.HumanoidRootPart.Position end
    return nil
end

local function clearAllESP()
    for id, data in pairs(espObjects) do
        if data.highlight then pcall(function() data.highlight:Destroy() end) end
        if data.tag then pcall(function() data.tag:Destroy() end) end
    end
    table.clear(espObjects)
end

local function createTag(model, name, color)
    local part = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildWhichIsA("BasePart")
    if not part then return nil end
    local bg = Instance.new("BillboardGui")
    bg.Size = UDim2.new(0, 150, 0, 30)
    bg.AlwaysOnTop = true
    bg.MaxDistance = 10000
    bg.Parent = part
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = color
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.TextStrokeTransparency = 0.5
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.Parent = bg
    return bg
end

local function addESP(model, category, color, labelName)
    if not model or not model.Parent then return end
    local id = model:GetFullName()
    if espObjects[id] then return end
    local h = Instance.new("Highlight")
    h.FillColor = color
    h.FillTransparency = 0.4
    h.OutlineColor = color
    h.OutlineTransparency = 0.2
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = model
    local tag = createTag(model, labelName, color)
    espObjects[id] = {highlight = h, tag = tag, model = model, category = category, labelName = labelName}
end

local function getObjectInfo(model)
    local name = model.Name
    if animalNames[name] then return "animal", animalNames[name] end
    if buildingNames[name] then return "building", buildingNames[name] end
    local lowerName = name:lower()
    for _, keyword in ipairs(monsterNames) do
        if lowerName == keyword or lowerName:find(keyword) then return "monster", "怪物" end
    end
    if model:FindFirstChild("Humanoid") and model:FindFirstChild("HumanoidRootPart") then
        if model.Humanoid.Health > 0 and model.Humanoid.MaxHealth > 50 then return "monster", "怪物" end
    end
    return nil, nil
end

local function fullRebuildESP()
    clearAllESP()
    if not Settings.ESP_Animal and not Settings.ESP_Monster and not Settings.ESP_Building then return end
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local objType, labelName = getObjectInfo(obj)
            if objType == "animal" and Settings.ESP_Animal then addESP(obj, "animal", Color3.fromRGB(255, 200, 50), labelName) end
            if objType == "monster" and Settings.ESP_Monster then addESP(obj, "monster", Color3.fromRGB(255, 80, 80), labelName) end
            if objType == "building" and Settings.ESP_Building then addESP(obj, "building", Color3.fromRGB(100, 200, 255), labelName) end
        end
    end
end

-- 每30秒自动刷新
task.spawn(function()
    while true do
        task.wait(30)
        if not stopAll and (Settings.ESP_Animal or Settings.ESP_Monster or Settings.ESP_Building) then
            fullRebuildESP()
        end
    end
end)

RunService.Heartbeat:Connect(function()
    local c = LocalPlayer.Character
    if not c or not c:FindFirstChild("HumanoidRootPart") then return end
    local root = c.HumanoidRootPart
    for id, data in pairs(espObjects) do
        if data.tag and data.tag.Parent and data.model and data.model.Parent then
            local label = data.tag:FindFirstChildWhichIsA("TextLabel")
            if label then
                local dist = (root.Position - data.model:GetPivot().Position).Magnitude
                label.Text = data.labelName .. " " .. math.floor(dist) .. "m"
            end
        end
    end
end)

workspace.DescendantAdded:Connect(function(obj)
    if obj:IsA("Model") then
        local objType, labelName = getObjectInfo(obj)
        if objType == "animal" and Settings.ESP_Animal then addESP(obj, "animal", Color3.fromRGB(255, 200, 50), labelName) end
        if objType == "monster" and Settings.ESP_Monster then addESP(obj, "monster", Color3.fromRGB(255, 80, 80), labelName) end
        if objType == "building" and Settings.ESP_Building then addESP(obj, "building", Color3.fromRGB(100, 200, 255), labelName) end
    end
end)

-- 夜视
local function updateNightVision()
    if Settings.NightVision then
        Lighting.Brightness = 3; Lighting.ClockTime = 14; Lighting.FogEnd = 500; Lighting.OutdoorAmbient = Color3.fromRGB(100, 100, 120)
    else
        Lighting.Brightness = 1; Lighting.FogEnd = 100; Lighting.OutdoorAmbient = Color3.fromRGB(0, 0, 0)
    end
end

local function loadFly()
    pcall(function() loadstring(game:HttpGet("https://raw.githubusercontent.com/hgvuyguyg/jjjjjjjjj/main/飞饼"))() end)
end

local function setSpeed(s)
    local c = LocalPlayer.Character
    if c and c:FindFirstChild("Humanoid") then c.Humanoid.WalkSpeed = s end
end

RunService.Heartbeat:Connect(function()
    if Settings.WalkSpeed ~= 16 then setSpeed(Settings.WalkSpeed) end
end)

local function getPlayerNames()
    local names = {}
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then table.insert(names, plr.Name) end
    end
    if #names == 0 then table.insert(names, "无其他玩家") end
    return names
end

