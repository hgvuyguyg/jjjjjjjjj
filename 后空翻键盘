local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()
if not WindUI then return end

WindUI:AddTheme({
    Name = "冰白",
    Accent = "#80C0FF",
    Outline = "#6090C0",
    Text = "#FFFFFF",
    Placeholder = "#D0E0FF",
})

local Window = WindUI:CreateWindow({
    Title = "加一后空翻键盘逃脱",
    Icon = "solar:moon-bold",
    Size = UDim2.fromOffset(500, 350),
    ToggleKey = Enum.KeyCode.RightShift,
    Theme = "冰白",
    Transparent = true,
    ScrollBarEnabled = true,
})

-- 功能状态变量
local speedEnabled = false
local autoWinEnabled = false
local lastTeleportTime = 0

-- 公告标签页
Window:Tab({Title = "公告", Icon = "solar:info-circle-bold"}):Paragraph({
    Title = "黑脚本--加1后空翻键盘逃脱",
    Desc = "主要功能：自动胜利 | 速度调节",
})

-- 主要功能标签页
local MainTab = Window:Tab({Title = "主要功能", Icon = "solar:star-bold"})

MainTab:Toggle({
    Title = "自动胜利",
    Value = false,
    Callback = function(enabled)
        autoWinEnabled = enabled
        
        if enabled then
            WindUI:Notify({
                Title = "自动胜利已开启",
                Content = "每3秒自动传送一次",
                Duration = 3
            })
        else
            WindUI:Notify({
                Title = "自动胜利已关闭",
                Content = "已停止自动传送",
                Duration = 2
            })
        end
    end
})

MainTab:Divider()

MainTab:Toggle({
    Title = "启用速度调节",
    Value = false,
    Callback = function(enabled)
        speedEnabled = enabled
        if not enabled then
            local player = game.Players.LocalPlayer
            if player and player.Character and player.Character:FindFirstChild("Humanoid") then
                player.Character.Humanoid.WalkSpeed = 16
            end
        end
    end
})

MainTab:Slider({
    Title = "移动速度",
    Value = {Min = 0, Max = 1000, Default = 16},
    Callback = function(speed)
        if speedEnabled then
            local player = game.Players.LocalPlayer
            if player and player.Character and player.Character:FindFirstChild("Humanoid") then
                player.Character.Humanoid.WalkSpeed = speed
            end
        end
    end
})

-- 自动胜利循环
game:GetService("RunService").Heartbeat:Connect(function()
    if autoWinEnabled then
        local currentTime = tick()
        if currentTime - lastTeleportTime >= 3 then
            local player = game.Players.LocalPlayer
            if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                player.Character.HumanoidRootPart.CFrame = CFrame.new(-6511, 265.4, -15758)
                lastTeleportTime = currentTime
                
                WindUI:Notify({
                    Title = "自动胜利",
                    Content = "已传送到胜利位置",
                    Duration = 2
                })
            end
        end
    end
end)

-- 设置标签页
local SettingsTab = Window:Tab({Title = "设置", Icon = "solar:settings-bold"})

local statusParagraph = SettingsTab:Paragraph({
    Title = "功能状态",
    Desc = "正在加载..."
})

-- 更新状态显示
local function updateStatus()
    local status = ""
    
    if speedEnabled then
        status = status .. "✅ 速度调节: 已开启\n"
    else
        status = status .. "❌ 速度调节: 未开启\n"
    end
    
    if autoWinEnabled then
        status = status .. "✅ 自动胜利: 已开启\n"
    else
        status = status .. "❌ 自动胜利: 未开启\n"
    end
    
    local player = game.Players.LocalPlayer
    if player and player.Character and player.Character:FindFirstChild("Humanoid") then
        local humanoid = player.Character.Humanoid
        status = status .. "✅ 角色: 已加载\n"
        status = status .. "当前速度: " .. humanoid.WalkSpeed .. "\n"
        
        local pos = player.Character.HumanoidRootPart.Position
        status = status .. "位置: " .. math.floor(pos.X) .. ", " .. math.floor(pos.Y) .. ", " .. math.floor(pos.Z)
    else
        status = status .. "❌ 角色: 未加载"
    end
    
    statusParagraph:SetDesc(status)
end

game:GetService("RunService").Heartbeat:Connect(function()
    updateStatus()
end)

SettingsTab:Button({
    Title = "关闭面板",
    Callback = function()
        Window:Close()
    end
})

WindUI:Notify({
    Title = "脚本加载完成",
    Content = "按RightShift开关面板",
    Duration = 3
})
