-- ==================== ESP系统 ====================
local function ClearESP()
    for obj, _ in pairs(espCache) do pcall(function() obj:Destroy() end) end
    espCache = {}
    for _, line in ipairs(tracerCache) do pcall(function() line:Remove() end) end
    tracerCache = {}
    for _, hl in ipairs(playerESPCache) do pcall(function() hl:Destroy() end) end
    playerESPCache = {}
end

local function CreateESP(obj, color, displayName)
    local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head") or obj:FindFirstChild("Handle")
    if not root then for _, child in ipairs(obj:GetDescendants()) do if child:IsA("BasePart") then root = child; break end end end
    if not root then return end
    
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local nameColor = GetNameColor(color)
    
    local hl = Instance.new("Highlight")
    hl.FillColor, hl.FillTransparency, hl.OutlineColor, hl.OutlineTransparency = color, 0.5, color, 0
    hl.Adornee, hl.DepthMode = obj, Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = obj; espCache[hl] = true
    
    local billboard = Instance.new("BillboardGui")
    billboard.Size, billboard.StudsOffset, billboard.AlwaysOnTop = UDim2.new(0, 200, 0, 40), Vector3.new(0, 3, 0), true
    billboard.Parent = root; espCache[billboard] = true
    local label = Instance.new("TextLabel")
    label.Size, label.BackgroundTransparency, label.Text, label.TextColor3 = UDim2.new(1, 0, 1, 0), 1, displayName, nameColor
    label.TextStrokeTransparency, label.TextStrokeColor3 = 0, Color3.fromRGB(0, 0, 0)
    label.Font, label.TextSize = Enum.Font.SourceSansBold, 18
    label.Parent = billboard
    
    if showDistance and hrp then
        local distVal = math.floor((hrp.Position - root.Position).Magnitude)
        local distBillboard = Instance.new("BillboardGui")
        distBillboard.Size, distBillboard.StudsOffset, distBillboard.AlwaysOnTop = UDim2.new(0, 100, 0, 25), Vector3.new(0, 1.5, 0), true
        distBillboard.Parent = root; espCache[distBillboard] = true
        local distLabel = Instance.new("TextLabel")
        distLabel.Size, distLabel.BackgroundTransparency, distLabel.Text = UDim2.new(1, 0, 1, 0), 1, distVal .. "m"
        distLabel.TextColor3, distLabel.TextStrokeTransparency, distLabel.TextStrokeColor3 = Color3.fromRGB(255, 255, 255), 0, Color3.fromRGB(0, 0, 0)
        distLabel.Font, distLabel.TextSize = Enum.Font.SourceSansBold, 14
        distLabel.Parent = distBillboard
    end
    
    if tracerEnabled and hrp then
        local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
        if onScreen then
            local line = Drawing.new("Line")
            line.From, line.To = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y), Vector2.new(screenPos.X, screenPos.Y)
            line.Color, line.Thickness, line.Visible = tracerColor, 1, true
            table.insert(tracerCache, line)
        end
    end
end

local function UpdateESP()
    ClearESP()
    
    if playerESP then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                pcall(function()
                    local hl = Instance.new("Highlight")
                    hl.FillColor, hl.FillTransparency, hl.OutlineColor = playerESPColor, 0.4, playerESPColor
                    hl.Adornee, hl.DepthMode = plr.Character, Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = plr.Character; table.insert(playerESPCache, hl)
                    local root = plr.Character:FindFirstChild("HumanoidRootPart") or plr.Character:FindFirstChild("Head")
                    if root then
                        local billboard = Instance.new("BillboardGui")
                        billboard.Size, billboard.StudsOffset, billboard.AlwaysOnTop = UDim2.new(0, 200, 0, 40), Vector3.new(0, 3, 0), true
                        billboard.Parent = root; table.insert(playerESPCache, billboard)
                        local label = Instance.new("TextLabel")
                        label.Size, label.BackgroundTransparency, label.Text = UDim2.new(1, 0, 1, 0), 1, plr.Name
                        label.TextColor3, label.TextStrokeTransparency, label.TextStrokeColor3 = GetNameColor(playerESPColor), 0, Color3.fromRGB(0, 0, 0)
                        label.Font, label.TextSize = Enum.Font.SourceSansBold, 18
                        label.Parent = billboard
                        if tracerEnabled then
                            local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                            if onScreen then
                                local line = Drawing.new("Line")
                                line.From, line.To = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y), Vector2.new(screenPos.X, screenPos.Y)
                                line.Color, line.Thickness, line.Visible = tracerColor, 1, true
                                table.insert(tracerCache, line)
                            end
                        end
                    end
                end)
            end
        end
    end
    
    if not (bunnyESP or wolfESP or chestESP or stoneESP or berryESP or childESP) and not tracerEnabled then return end
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        pcall(function()
            if not obj:IsA("Model") then return end
            local name = obj.Name
            if bunnyESP and name == "Bunny" then CreateESP(obj, bunnyESPColor, "兔子") end
            if wolfESP and name == "Wolf" then CreateESP(obj, wolfESPColor, "狼") end
            if chestESP and name == "ChestLid" then CreateESP(obj, chestESPColor, "宝箱") end
            if stoneESP and name == "Stone" then CreateESP(obj, stoneESPColor, "宝藏土堆") end
            if berryESP and name == "Berry" then CreateESP(obj, berryESPColor, "蓝莓") end
            if childESP and string.find(name, "Lost Child") then CreateESP(obj, childESPColor, "小孩") end
        end)
    end
end

task.spawn(function() while task.wait(0.3) do UpdateESP() end end)

-- ==================== 传送功能 ====================
local function TeleportToNearest(targetName, displayName)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local closest, closestDist = nil, math.huge
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        pcall(function()
            local match = false
            if obj:IsA("Model") and obj.Name == targetName then match = true
            elseif obj:IsA("BasePart") and obj.Name == targetName then match = true
            elseif targetName == "Lost Child" and obj:IsA("Model") and string.find(obj.Name, "Lost Child") then match = true end
            if match then
                local root = obj:IsA("Model") and (obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head") or obj:FindFirstChild("Handle")) or obj
                if not root and obj:IsA("Model") then for _, child in ipairs(obj:GetDescendants()) do if child:IsA("BasePart") then root = child; break end end end
                if root then
                    local dist = (hrp.Position - root.Position).Magnitude
                    if dist < closestDist then closestDist = dist; closest = root end
                end
            end
        end)
    end
    
    if closest then pcall(function() hrp.CFrame = closest.CFrame * CFrame.new(0, 2, 0) end); WI:Notify({Title = "传送成功", Content = displayName, Duration = 2})
    else WI:Notify({Title = "传送失败", Content = "没找到" .. displayName, Duration = 2}) end
end

