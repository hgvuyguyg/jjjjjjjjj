-- ==================== 防止扣除理智 ====================
local noSanityHooks = {}

local function setupNoSanity()
    if noSanityHooks.mtHook then return end
    
    local Event = ReplicatedStorage.Util.Net["RE/PlayerLostSanity"]
    
    noSanityHooks.mtHook = hookmetamethod(game, "__namecall", function(...)
        local self = ...
        local method = getnamecallmethod()
        
        if self == Event and method == "FireServer" and Settings.NoSanity then
            return nil
        end
        
        return noSanityHooks.mtHook(...)
    end)
    
    noSanityHooks.oldFireServer = hookfunction(Event.FireServer, function(...)
        local self = ...
        if self == Event and Settings.NoSanity then
            return nil
        end
        return noSanityHooks.oldFireServer(self, ...)
    end)
end

-- ==================== 伪人检测关键词（英文） ====================
local SKINWALKER_KEYWORDS = {
    "skinwalker", "skin walker", "monster", "entity", "creature", 
    "fake", "impostor", "imposter", "mimic", "horror", "scary", 
    "beast", "demon", "cryptid", "anomaly", "nightmare", "terror",
    "shapeshifter", "shape shifter", "possessed", "haunted", "evil",
    "fiend", "specter", "spectre", "wraith", "phantom", "shadow",
    "abomination", "mutant", "aberration", "crawler", "stalker",
    "flesh", "gore", "blood", "scream", "whisper", "unknown",
    "thing", "being", "presence", "intruder", "invader", "predator",
    "nonhuman", "non human", "inhuman", "paranormal", "supernatural",
    "slender", "sirenhead", "siren head", "cartoon cat", "scp",
    "alternate", "doppelganger", "doppel", "changeling",
}

local function isSkinwalker(name)
    local lowerName = name:lower()
    for _, keyword in pairs(SKINWALKER_KEYWORDS) do
        if lowerName:find(keyword) then
            return true
        end
    end
    return false
end

-- ==================== 获取位置 ====================
local function getPos()
    local c = LocalPlayer.Character
    if c and c:FindFirstChild("HumanoidRootPart") then return c.HumanoidRootPart.Position end
    return nil
end

local function tp(pos)
    local c = LocalPlayer.Character
    if c and c:FindFirstChild("HumanoidRootPart") then
        c.HumanoidRootPart.CFrame = CFrame.new(pos)
    end
end

local function forcePressE(duration)
    local c = LocalPlayer.Character
    if not c then return end
    
    task.wait(0.5)
    
    local startTime = tick()
    while tick() - startTime < duration do
        if not Settings.AutoReception or stopAll then break end
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, nil)
        task.wait(0.3)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, nil)
        task.wait(0.3)
    end
end

local function hasAnimalNear(pos)
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("Head") then
            local root = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
            if root then
                local dist = (pos - root.Position).Magnitude
                if dist <= 20 then
                    local isPlayer = false
                    for _, plr in pairs(Players:GetPlayers()) do
                        if plr.Character == obj then isPlayer = true break end
                    end
                    if not isPlayer then return true end
                end
            end
        end
    end
    return false
end

