-- ==================== 获取事件 ====================
local function GetSanityEvent()
    local e = ReplicatedStorage:FindFirstChild("Util")
    if e then
        e = e:FindFirstChild("Net")
        if e then
            e = e:FindFirstChild("RE/PlayerLostSanity")
        end
    end
    return e
end

-- ==================== 永久拦截（只hook一次，用变量控制开关） ====================
local function SetupPermanentHook()
    if hookActive then return end
    
    Event = GetSanityEvent()
    if not Event then
        WI:Notify({
            Title = "❌ 错误",
            Content = "未找到远程事件",
            Duration = 2,
            Type = "error"
        })
        return
    end
    
    interceptEnabled = true  -- 默认开启拦截
    
    -- 只hook一次，永久生效，用interceptEnabled控制开关
    mtHook = hookmetamethod(game, "__namecall", function(...)
        local self = ...
        if rawequal(self, Event) and getnamecallmethod() == "FireServer" then
            if interceptEnabled then
                print("✅ 拦截理智扣除")
                return
            else
                print("⏸️ 拦截暂停，放行")
                return mtHook(...)
            end
        end
        return mtHook(...)
    end)
    
    OldFireServer = hookfunction(Event.FireServer, function(...)
        local self = ...
        if rawequal(self, Event) then
            if interceptEnabled then
                print("✅ 拦截理智扣除")
                return
            else
                print("⏸️ 拦截暂停，放行")
                return OldFireServer(self, ...)
            end
        end
        return OldFireServer(self, ...)
    end)
    
    hookActive = true
    print("🛡️ 永久拦截已开启")
end

-- ==================== 30秒循环 ====================
local function StartSanityLoop()
    if sanityThread then return end
    
    sanityThread = task.spawn(function()
        while sanityBypass do
            -- 等待30秒
            task.wait(30)
            
            -- 暂停拦截（放行扣理智包）
            interceptEnabled = false
            print("⏸️ 拦截暂停，准备扣理智")
            task.wait(0.5)
            
            -- 执行扣理智事件
            pcall(function()
                local e = GetSanityEvent()
                if e then
                    e:FireServer(1, "Job Stress", true)
                    print("💀 执行扣理智")
                end
            end)
            
            task.wait(0.5)
            
            -- 恢复拦截
            interceptEnabled = true
            print("🛡️ 拦截恢复")
        end
    end)
end

local function StopSanityBypass()
    sanityBypass = false
    interceptEnabled = false
    if sanityThread then
        task.cancel(sanityThread)
        sanityThread = nil
    end
    print("⏹️ 理智循环已停止")
end

