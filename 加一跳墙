-- 加一跳墙练习 脚本 v1.0.0
-- WindUI蓝白版 | 自动胜利

local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()
if not WindUI then return end

WindUI:AddTheme({
    Name = "冰白",
    Accent = "#80C0FF",
    Outline = "#6090C0",
    Text = "#FFFFFF",
    Placeholder = "#D0E0FF",
})

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local Settings = {
    AutoWinEnabled = false,
}

local VERSION = "v1.0.0"
local lastWinTime = 0
local WinDelay = 3 -- 固定3秒

-- 自动胜利
local function autoWin()
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        character.HumanoidRootPart.CFrame = CFrame.new(-415, 1238.9, -4690)
        return true
    end
    return false
end

-- 自动赢循环（3秒固定）
task.spawn(function()
    while true do
        if Settings.AutoWinEnabled then
            local currentTime = tick()
            if currentTime - lastWinTime >= WinDelay then
                autoWin()
                lastWinTime = currentTime
            end
        end
        task.wait(0.05)
    end
end)

local Window = WindUI:CreateWindow({
    Title = "加一跳墙奥比逃脱",
    Icon = "solar:moon-bold",
    Size = UDim2.fromOffset(400, 350),
    ToggleKey = Enum.KeyCode.RightShift,
    Theme = "冰白",
    Transparent = true,
    ScrollBarEnabled = true,
})

Window:Tab({Title = "公告", Icon = "solar:info-circle-bold"}):Paragraph({
    Title = "黑脚本--加一跳墙奥比逃脱",
    Desc = "版本: " .. VERSION .. "\n\n支持功能：\n• 自动胜利（每3秒传送）",
})

local MainTab = Window:Tab({Title = "主要功能", Icon = "solar:star-bold"})

MainTab:Toggle({
    Title = "自动胜利",
    Value = false,
    Callback = function(enabled)
        Settings.AutoWinEnabled = enabled
        
        if enabled then
            WindUI:Notify({
                Title = "自动胜利已开启",
                Content = "每3秒传送（固定）",
                Duration = 3
            })
        else
            WindUI:Notify({
                Title = "自动胜利已关闭",
                Content = "已停止",
                Duration = 2
            })
        end
    end
})

local SettingsTab = Window:Tab({Title = "设置", Icon = "solar:settings-bold"})

local statusParagraph = SettingsTab:Paragraph({
    Title = "功能状态",
    Desc = "正在加载..."
})

local function updateStatus()
    local status = ""
    if Settings.AutoWinEnabled then
        status = status .. "✅ 自动胜利: 已开启 (3秒)\n"
    else
        status = status .. "❌ 自动胜利: 未开启\n"
    end
    statusParagraph:SetDesc(status)
end

RunService.Heartbeat:Connect(function() updateStatus() end)

SettingsTab:Button({
    Title = "关闭面板",
    Callback = function() Window:Close() end
})

Window:OnClose(function() end)

WindUI:Notify({
    Title = "加一跳墙练习",
    Content = VERSION .. " 加载完成",
    Duration = 3
})
