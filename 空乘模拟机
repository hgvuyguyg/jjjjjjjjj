-- 空乘模拟器 脚本 v1.0.8
-- WindUI蓝白版 | 简约版

local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()
if not WindUI then return end

WindUI:AddTheme({
    Name = "冰白",
    Accent = "#80C0FF",
    Outline = "#6090C0",
    Text = "#FFFFFF",
    Placeholder = "#D0E0FF",
})

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")

local VERSION = "v1.0.8"

-- ========== 远程事件 ==========
local function getRemoteEvent()
    local character = LocalPlayer.Character
    if not character then return nil end
    
    local client1 = character:FindFirstChild("Client")
    if not client1 then return nil end
    
    local client2 = client1:FindFirstChild("Client")
    if not client2 then return nil end
    
    return client2:FindFirstChild("RemoteEvent")
end

-- ========== 获取所有NPC ==========
local function getAllNPCs()
    local npcs = {}
    local flights = Workspace:FindFirstChild("flights")
    if not flights then return npcs end

    for _, flight in pairs(flights:GetChildren()) do
        local clientFolder = flight:FindFirstChild("clientFolder")
        if clientFolder then
            for _, plane in pairs(clientFolder:GetChildren()) do
                local npcFolder = plane:FindFirstChild("npcs")
                if npcFolder then
                    for _, npc in pairs(npcFolder:GetChildren()) do
                        table.insert(npcs, npc)
                    end
                end
            end
        end
    end
    return npcs
end

-- ========== 服务所有乘客 ==========
local function serviceAllPassengers()
    local event = getRemoteEvent()
    if not event then
        WindUI:Notify({Title = "错误", Content = "找不到RemoteEvent", Duration = 2})
        return 0
    end
    
    local npcs = getAllNPCs()
    if #npcs == 0 then
        WindUI:Notify({Title = "提示", Content = "未找到任何乘客", Duration = 2})
        return 0
    end
    
    local count = 0
    for _, npc in pairs(npcs) do
        pcall(function()
            event:FireServer("Fix", "seat", npc)
            task.wait(0.02)
            event:FireServer("Fix", "seatbelt", npc)
            task.wait(0.02)
            event:FireServer("Fix", "tray", npc)
            task.wait(0.02)
        end)
        count = count + 1
    end
    return count
end

-- ========== 关闭所有储物柜 ==========
local function closeAllBins()
    local event = getRemoteEvent()
    if not event then
        WindUI:Notify({Title = "错误", Content = "找不到RemoteEvent", Duration = 2})
        return 0
    end
    
    local count = 0
    for i = 1, 1000 do
        pcall(function()
            event:FireServer("prompt", "Bins", i)
        end)
        count = count + 1
        if i % 10 == 0 then
            task.wait(0.01)
        end
    end
    return count
end

-- ========== 跳跃功能 ==========
local function jump()
    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    if humanoid.FloorMaterial ~= Enum.Material.Air then
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        WindUI:Notify({Title = "跳跃", Content = "已跳跃", Duration = 0.5})
    end
end

-- ========== UI ==========
