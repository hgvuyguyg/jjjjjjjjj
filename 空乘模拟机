MainTab:Divider()

MainTab:Button({
    Title = "关闭所有储物柜",
    Callback = function()
        local count = closeAllBins()
        WindUI:Notify({Title = "完成", Content = "已关闭 " .. count .. " 个储物柜", Duration = 2})
    end
})

MainTab:Divider()

MainTab:Button({
    Title = "跳跃",
    Callback = function()
        jump()
    end
})

local SettingsTab = Window:Tab({Title = "设置", Icon = "solar:settings-bold"})
local statusPara = SettingsTab:Paragraph({Title = "功能状态", Desc = "加载中..."})

task.spawn(function()
    while true do
        local status = ""
        local npcs = getAllNPCs()
        status = status .. "乘客数量: " .. #npcs .. "\n"
        
        local remote = getRemoteEvent()
        status = status .. "RemoteEvent: " .. (remote and "已找到" or "未找到") .. "\n"
        
        status = status .. "帧率: " .. math.floor(1 / task.wait()) .. " FPS"
        statusPara:SetDesc(status)
        task.wait(1)
    end
end)

SettingsTab:Button({
    Title = "关闭面板",
    Callback = function()
        Window:Close()
    end
})

WindUI:Notify({
    Title = "空乘模拟器",
    Content = VERSION .. " 加载完成",
    Duration = 3
})
