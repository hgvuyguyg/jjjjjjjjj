local function getAllItemsOfType(itemType)
    local items = {}
    local seenObjects = {}
    local keyword = itemType.Keyword:lower()
    local excludes = itemType.Exclude or {}

    for _, v in pairs(workspace:GetDescendants()) do
        if v.Name then
            local name = v.Name:lower()
            if name:find(keyword) then
                local shouldExclude = false
                for _, excludeWord in pairs(excludes) do
                    if name:find(excludeWord:lower()) then
                        shouldExclude = true
                        break
                    end
                end
                
                if not shouldExclude then
                    local rootPart = nil
                    local objSize = nil
                    
                    if v:IsA("BasePart") then
                        rootPart = v
                        objSize = math.max(v.Size.X, v.Size.Y, v.Size.Z)
                    elseif v:IsA("Model") then
                        rootPart = v:FindFirstChild("HumanoidRootPart") or v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart")
                        local modelSize = v:GetExtentsSize()
                        objSize = math.max(modelSize.X, modelSize.Y, modelSize.Z)
                    end
                    
                    if rootPart and objSize and objSize <= 8 and not seenObjects[v] then
                        seenObjects[v] = true
                        table.insert(items, {Object = v, RootPart = rootPart})
                    end
                end
            end
        end
    end

    return items
end

task.spawn(function()
    while true do
        if Settings.AutoSuckEnabled then
            local player = game.Players.LocalPlayer
            if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local playerRoot = player.Character.HumanoidRootPart
                local selectedItems = Settings.SuckItems or {}
                local angleStep = 0

                for _, displayName in pairs(selectedItems) do
                    if not Settings.AutoSuckEnabled then break end
                    local itemType = nil
                    for _, it in pairs(ITEM_TYPES) do
                        if it.DisplayName == displayName then
                            itemType = it
                            break
                        end
                    end
                    if itemType then
                        local items = getAllItemsOfType(itemType)
                        for _, item in pairs(items) do
                            if not Settings.AutoSuckEnabled then break end
                            if item.RootPart and item.RootPart.Parent then
                                local angle = math.rad(angleStep)
                                local x = math.cos(angle) * Settings.SuckRadius
                                local z = math.sin(angle) * Settings.SuckRadius
                                local targetPos = playerRoot.Position + Vector3.new(x, 0, z)
                                item.RootPart.CFrame = CFrame.new(targetPos)
                                angleStep = angleStep + 15
                            end
                        end
                    end
                    task.wait(0.05)
                end
            end
        end
        task.wait(Settings.SuckDelay)
    end
end)

function TeleportTo(pos)
    local player = game.Players.LocalPlayer
    if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        player.Character.HumanoidRootPart.CFrame = CFrame.new(pos)
    end
end

local function getChestList(type)
    local chests = {}
    local targetNames = {}
    
    if type == "木箱子" then
        targetNames = {"WoodChest", "WoodCrate", "WoodenChest", "WoodBox"}
    elseif type == "冰箱" then
        targetNames = {"Fridge", "Refrigerator"}
    elseif type == "超级武器箱" then
        targetNames = {"UltraWeaponCrate"}
    elseif type == "玻璃门冰箱" then
        targetNames = {"ClassFridge"}
    elseif type == "中型武器箱" then
        targetNames = {"MediumWeaponCrate"}
    end
    
    local seenObjects = {}
    
    for _, v in pairs(workspace:GetDescendants()) do
        for _, targetName in pairs(targetNames) do
            if v.Name == targetName then
                local rootPart = nil
                if v:IsA("Model") then
                    rootPart = v:FindFirstChild("HumanoidRootPart") or v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart")
                elseif v:IsA("BasePart") then
                    rootPart = v
                end
                
                if rootPart and not seenObjects[v] then
                    seenObjects[v] = true
                    table.insert(chests, {Object = v, RootPart = rootPart, Position = rootPart.Position})
                end
                break
            end
        end
    end
    
    local player = game.Players.LocalPlayer
    if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        table.sort(chests, function(a, b)
            local distA = (a.Position - player.Character.HumanoidRootPart.Position).Magnitude
            local distB = (b.Position - player.Character.HumanoidRootPart.Position).Magnitude
            return distA < distB
        end)
    end
    
    return chests
end

function TeleportToChest(type)
    local player = game.Players.LocalPlayer
    if not player or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
        return
    end
    
    local chests = getChestList(type)
    
    if #chests == 0 then
        return
    end
    
    local target = nil
    for _, chest in pairs(chests) do
        if not visitedChests[chest.Object] then
            target = chest
            break
        end
    end
    
    if not target then
        visitedChests = {}
        target = chests[1]
    end
    
    if target then
        if type == "木箱子" or type == "超级武器箱" or type == "中型武器箱" then
            player.Character.HumanoidRootPart.CFrame = CFrame.new(target.Position + Vector3.new(0, 3, 0))
        else
            local direction = (target.Position - player.Character.HumanoidRootPart.Position).Unit
            player.Character.HumanoidRootPart.CFrame = CFrame.new(target.Position + direction * 3)
        end
        visitedChests[target.Object] = true
    end
end

