-- 🌙 最强战场 | V1.6

local WI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()
if not WI then return end

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local Camera = Workspace.CurrentCamera

-- 变量
local selectedPlayer = ""
local aimbotEnabled = false

local stalkPlayer = ""
local stalkEnabled = false

local playerESP = false
local playerESPColor = Color3.fromRGB(255, 50, 50)
local showDistance = false
local playerESPObjects = {}

local speedBoost = false
local speedValue = 50

-- ==================== 辅助函数 ====================
local function getPlayerNames()
    local n = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then table.insert(n, p.Name) end
    end
    if #n == 0 then table.insert(n, "无玩家") end
    return n
end

-- ==================== 冰白主题 ====================
WI:AddTheme({
    Name = "冰白",
    Accent = "#80C0FF",
    Outline = "#6090C0",
    Text = "#FFFFFF",
    Placeholder = "#D0E0FF"
})

-- ==================== 速度 ====================
RunService.RenderStepped:Connect(function()
    if speedBoost then
        pcall(function()
            local c = LocalPlayer.Character
            if c and c:FindFirstChild("Humanoid") then
                c.Humanoid.WalkSpeed = speedValue
            end
        end)
    end
end)

-- ==================== 选定杀戮（贴脸传送+自瞄+1234+G）====================
spawn(function()
    while true do
        if aimbotEnabled and selectedPlayer ~= "" and selectedPlayer ~= "无玩家" then
            pcall(function()
                local target = Players:FindFirstChild(selectedPlayer)
                if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
                    task.wait(0.005)
                    return
                end

                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then
                    task.wait(0.005)
                    return
                end
                local hrp = char.HumanoidRootPart
                local targetHRP = target.Character.HumanoidRootPart
                local targetHead = target.Character:FindFirstChild("Head")

                -- 贴脸传送（离更近，距离1.5）
                local behindPos = targetHRP.CFrame * CFrame.new(0, 0, 1.5)
                hrp.CFrame = behindPos

                -- 自瞄头部
                if targetHead then
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
                end

                -- 只按1234和G，不点左键
                local keys = {Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four, Enum.KeyCode.G}
                for _, key in ipairs(keys) do
                    VirtualInputManager:SendKeyEvent(true, key, false, game)
                    VirtualInputManager:SendKeyEvent(false, key, false, game)
                end
            end)
        end
        task.wait(0.005)
    end
end)

-- ==================== 单独锁背 ====================
spawn(function()
    while true do
        if stalkEnabled and stalkPlayer ~= "" and stalkPlayer ~= "无玩家" then
            pcall(function()
                local target = Players:FindFirstChild(stalkPlayer)
                if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
                    task.wait(0.005)
                    return
                end

                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then
                    task.wait(0.005)
                    return
                end
                local hrp = char.HumanoidRootPart
                local targetHRP = target.Character.HumanoidRootPart

                local behindPos = targetHRP.CFrame * CFrame.new(0, 0, 2)
                hrp.CFrame = behindPos
            end)
        end
        task.wait(0.005)
    end
end)

-- ==================== 玩家ESP ====================
local function clearPlayer()
    for _, obj in ipairs(playerESPObjects) do
        pcall(function() obj:Destroy() end)
    end
    playerESPObjects = {}
end

local function refreshPlayerESP()
    clearPlayer()
    if not playerESP then return end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            pcall(function()
                local c = plr.Character
                local root = c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Head")
                if not root then return end

                local hl = Instance.new("Highlight")
                hl.FillColor = playerESPColor
                hl.FillTransparency = 0.3
                hl.OutlineColor = playerESPColor
                hl.OutlineTransparency = 0.2
                hl.Adornee = c
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Parent = c
                table.insert(playerESPObjects, hl)

                local bb = Instance.new("BillboardGui")
                bb.Size = UDim2.new(0, 200, 0, 30)
                bb.StudsOffset = Vector3.new(0, 3, 0)
                bb.AlwaysOnTop = true
                bb.Adornee = root
                bb.Parent = root
                table.insert(playerESPObjects, bb)

                local lb = Instance.new("TextLabel")
                lb.Size = UDim2.new(1, 0, 1, 0)
                lb.BackgroundTransparency = 1
                lb.Text = plr.Name
                lb.TextColor3 = playerESPColor
                lb.TextStrokeTransparency = 0
                lb.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                lb.Font = Enum.Font.SourceSansBold
                lb.TextSize = 16
                lb.Parent = bb

                if showDistance then
                    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if myRoot then
                        local d = math.floor((myRoot.Position - root.Position).Magnitude)
                        local db = Instance.new("BillboardGui")
                        db.Size = UDim2.new(0, 100, 0, 20)
                        db.StudsOffset = Vector3.new(0, -1.5, 0)
                        db.AlwaysOnTop = true
                        db.Adornee = root
                        db.Parent = root
                        table.insert(playerESPObjects, db)

                        local dl = Instance.new("TextLabel")
                        dl.Size = UDim2.new(1, 0, 1, 0)
                        dl.BackgroundTransparency = 1
                        dl.Text = d .. "m"
                        dl.TextColor3 = Color3.fromRGB(255, 255, 255)
                        dl.TextStrokeTransparency = 0
                        dl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                        dl.Font = Enum.Font.SourceSansBold
                        dl.TextSize = 14
                        dl.Parent = db
                    end
                end
            end)
        end
    end
end

task.spawn(function()
    while task.wait(1.5) do
        pcall(function() refreshPlayerESP() end)
    end
end)

-- ==================== UI ====================
