end)

local function clearESP()
    for _, obj in pairs(espHighlights) do
        pcall(function() obj:Destroy() end)
    end
    table.clear(espHighlights)
end

local function updateESP()
    clearESP()
    if not espEnabled then return end
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            pcall(function()
                local char = p.Character
                local hl = Instance.new("Highlight")
                hl.FillColor = Color3.fromRGB(0, 150, 255)
                hl.FillTransparency = 0.3
                hl.OutlineColor = Color3.new(1, 1, 1)
                hl.Adornee = char
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Parent = char
                table.insert(espHighlights, hl)
                
                local bb = Instance.new("BillboardGui")
                bb.Size = UDim2.new(0, 200, 0, 30)
                bb.AlwaysOnTop = true
                bb.Parent = char
                local head = char:FindFirstChild("Head")
                if head then bb.Adornee = head end
                
                local label = Instance.new("TextLabel")
                label.Size = UDim2.new(1, 0, 1, 0)
                label.BackgroundTransparency = 1
                label.TextColor3 = Color3.new(1, 1, 1)
                label.Text = p.Name
                label.Font = Enum.Font.SourceSansBold
                label.TextSize = 14
                label.TextStrokeColor3 = Color3.new(0, 0, 0)
                label.TextStrokeTransparency = 0.5
                label.Parent = bb
                table.insert(espHighlights, bb)
            end)
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.5)
        if espEnabled then
            updateESP()
        else
            clearESP()
        end
    end
end)

local function GetPlayerNames()
    local names = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(names, p.Name)
        end
    end
    return names
end

local function TeleportToPlayer(playerName)
    if not playerName or playerName == "" then
        StarterGui:SetCore("SendNotification", {
            Title = "失败",
            Text = "请选择玩家",
            Duration = 2
        })
        return
    end
    
    local target = Players:FindFirstChild(playerName)
    if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
        StarterGui:SetCore("SendNotification", {
            Title = "失败",
            Text = "目标不存在",
            Duration = 2
        })
        return
    end
    
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        StarterGui:SetCore("SendNotification", {
            Title = "失败",
            Text = "角色不存在",
            Duration = 2
        })
        return
    end
    
    char.HumanoidRootPart.CFrame = CFrame.new(target.Character.HumanoidRootPart.Position + Vector3.new(0, 2, 0))
end

local function IsTooClose(pos)
    for _, p in ipairs(recentTeleports) do
        if (pos - p).Magnitude < 15 then
            return true
        end
    end
    return false
end

local function IsRealBase(obj)
    if obj.Name ~= "Base" then
        return false
    end
    
    local parent = obj.Parent
    if parent then
        local parentName = parent.Name:lower()
        local skip = {"lamp","wall","ceiling","floor","chair","table","plant","tree",
                      "decoration","painting","frame","mirror","glass","door","window",
                      "shelf","rack","fence","post","bed","cabinet","drawer","counter"}
        
        for _, word in ipairs(skip) do
            if parentName:find(word) then
                return false
            end
        end
        
        if parent:IsA("Model") then
            local count = 0
            for _, child in ipairs(parent:GetChildren()) do
                if child:IsA("BasePart") then
                    count = count + 1
                end
            end
            if count > 3 then
                return false
            end
        end
    end
    
    return true
end

local function FindBases()
    local bases = {}
    if not centerPos then
        return bases
    end
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if IsRealBase(obj) then
            local pos = nil
            if obj:IsA("Part") then
                pos = obj.Position
            elseif obj:IsA("Model") then
                local p = obj:FindFirstChildWhichIsA("BasePart")
                if p then pos = p.Position end
            end
            
            if pos then
                local dist = (pos - centerPos).Magnitude
                if dist <= COLLECT_RADIUS then
                    local id = tostring(obj)
                    if not collectedTables[id] and not IsTooClose(pos) then
                        table.insert(bases, {obj = obj, pos = pos, id = id, dist = dist})
                    end
                end
            end
        end
    end
    
    table.sort(bases, function(a, b) return a.dist < b.dist end)
    return bases
end

local function StartCollect()
    if collectThread then
        task.cancel(collectThread)
        collectThread = nil
    end
    table.clear(collectedTables)
    table.clear(recentTeleports)
    isCollecting = false
    
    collectThread = task.spawn(function()
        while autoCollect do
            pcall(function()
                local char = LocalPlayer.Character
                if not char then return end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                
                local bases = FindBases()
                if #bases == 0 then
                    task.wait(2)
                    return
                end
                
                for _, data in ipairs(bases) do
                    if not autoCollect then break end
                    if isCollecting then
                        task.wait(0.1)
                    else
                        local target = data.obj
                        local pos = data.pos
                        
                        if target and pos then
                            isCollecting = true
                            hrp.CFrame = CFrame.new(pos + Vector3.new(0, 2, 0))
                            task.wait(0.3)
                            
                            table.insert(recentTeleports, pos)
                            if #recentTeleports > 10 then
                                table.remove(recentTeleports, 1)
                            end
                            
                            local prompt = nil
                            if target:IsA("Part") then
                                prompt = target:FindFirstChildOfClass("ProximityPrompt")
                            elseif target:IsA("Model") then
                                for _, d in ipairs(target:GetDescendants()) do
                                    if d:IsA("ProximityPrompt") then
                                        prompt = d
                                        break
                                    end
                                end
                            end
                            
                            if prompt and prompt.Enabled then
                                fireproximityprompt(prompt)
                            end
                            
                            collectedTables[data.id] = true
                            isCollecting = false
                            task.wait(0.3)
                        end
                    end
                end
                
                table.clear(collectedTables)
                task.wait(2)
            end)
            task.wait(0.5)
        end
    end)
end

task.spawn(function()
    while true do
        task.wait(0.2)
        if autoInteract then
            pcall(function()
                local char = LocalPlayer.Character
                if not char then return end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                local pos = hrp.Position
                
                for _, o in ipairs(Workspace:GetDescendants()) do
                    if o:IsA("ProximityPrompt") and o.Enabled then
                        local parent = o.Parent
                        if parent then
                            local ppos = nil
                            if parent:IsA("BasePart") then
                                ppos = parent.Position
                            elseif parent:IsA("Model") then
                                local bp = parent:FindFirstChildWhichIsA("BasePart")
                                if bp then ppos = bp.Position end
                            end
                            
                            if ppos and (ppos - pos).Magnitude < 10 then
                                fireproximityprompt(o)
                            end
                        end
                    end
                end
            end)
        end
    end
end)

