task.spawn(function()
    -- 有用物体关键词（只点这些）
    local usefulKeywords = {
        "register","收银","counter","收银台",
        "oven","烤箱","stove","炉子","fryer","炸锅",
        "grill","烤架","mixer","搅拌机",
        "prep","备料","cutting","切菜","sink","水槽",
        "fridge","冰箱","freezer","冷冻柜",
        "shelf","架子","rack","货架","display","展示柜",
        "trash","垃圾桶","bin","桶"
    }
    
    -- 绝对跳过的关键词（所有场景物体）
    local skipKeywords = {
        "flower","花","plant","植物","tree","树","bush","灌木","grass","草","weed","杂草",
        "lamp","灯","light","台灯","wall","墙","floor","地板","ceiling","天花板",
        "chair","椅子","stool","凳","seat","座位","table","桌","desk","书桌",
        "door","门","window","窗","窗户","sign","告示牌","board","看板",
        "decoration","装饰","pot","花盆","box","箱子","crate","货箱",
        "rock","石头","stone","石块","post","柱子","fence","栅栏","rail","栏杆",
        "glass","玻璃","mirror","镜子","countertop","台面","sink","水槽",
        "cabinet","柜子","wardrobe","衣柜","closet","壁橱","bed","床",
        "painting","画","drawing","canvas","picture","frame","photo","portrait",
        "hide","hiding","drawer","抽屉","shelf","架子","rack","货架"
    }
    
    while true do
        if autoInteract then
            pcall(function()
                local p = LocalPlayer.Character
                if not p or not p:FindFirstChild("HumanoidRootPart") then return end
                local hrp = p.HumanoidRootPart
                local hrpPos = hrp.Position

                for _, o in ipairs(Workspace:GetDescendants()) do
                    if o:IsA("ProximityPrompt") and o.Enabled then
                        local pp = o.Parent
                        if not pp then continue end

                        local po = nil
                        if pp:IsA("BasePart") then
                            po = pp.Position
                        elseif pp:IsA("Model") then
                            local bp = pp:FindFirstChildWhichIsA("BasePart")
                            if bp then po = bp.Position end
                        end

                        if po and (po - hrpPos).Magnitude < 10 then
                            local fullName = pp.Name:lower() .. " " .. (pp.Parent and pp.Parent.Name:lower() or "")
                            
                            -- 先检查是否应该跳过
                            local shouldSkip = false
                            for _, kw in ipairs(skipKeywords) do
                                if fullName:find(kw) then
                                    shouldSkip = true
                                    break
                                end
                            end
                            if shouldSkip then continue end
                            
                            -- 检查是否在有用列表里
                            local isUseful = false
                            for _, kw in ipairs(usefulKeywords) do
                                if fullName:find(kw) then
                                    isUseful = true
                                    break
                                end
                            end
                            
                            -- 如果名字包含交互关键词也点
                            if not isUseful and (fullName:find("button") or fullName:find("prompt") or fullName:find("interact") or fullName:find("click")) then
                                isUseful = true
                            end
                            
                            if isUseful then
                                fireproximityprompt(o)
                            end
                        end
                    end
                end
            end)
        end
        task.wait(0.2)
    end
end)

-- ==================== 检查是否在15米内重复传送 ====================
local function IsTooCloseToRecent(pos)
    local count = 0
    for _, recentPos in ipairs(recentTeleports) do
        if (pos - recentPos).Magnitude < 15 then
            count = count + 1
            if count >= 2 then
                return true
            end
        end
    end
    return false
end

-- ==================== 自动收钱（只传完美匹配Base，跳过所有误识别） ====================
local function FindAllBases()
    local bases = {}
    if not centerPos then
        print("⚠️ 中心点未设置，请重新开启自动收钱")
        return bases
    end

    -- 需要跳过的关键词（防止传到花坛/树/灯等）
    local skipBaseKeywords = {
        "flower","花","plant","植物","tree","树","bush","灌木","grass","草",
        "lamp","灯","light","台灯","wall","墙","floor","地板","ceiling","天花板",
        "chair","椅子","table","桌","desk","书桌","door","门","window","窗",
        "sign","告示牌","board","看板","decoration","装饰","pot","花盆",
        "rock","石头","stone","石块","post","柱子","fence","栅栏","glass","玻璃",
        "cabinet","柜子","wardrobe","衣柜","closet","壁橱","bed","床",
        "painting","画","drawing","canvas","picture","frame","photo","portrait",
        "shelf","架子","rack","货架","drawer","抽屉","countertop","台面"
    }

    for _, obj in ipairs(Workspace:GetDescendants()) do
        -- 只匹配名字完全等于 "Base" 的物体
        if obj.Name == "Base" then
            if obj:IsA("Part") or obj:IsA("Model") then
                local pos = nil
                if obj:IsA("Part") then
                    pos = obj.Position
                elseif obj:IsA("Model") then
                    local p = obj:FindFirstChildWhichIsA("BasePart")
                    if p then pos = p.Position end
                end
                if pos and (pos - centerPos).Magnitude <= 200 then
                    -- 检查名字是否包含跳过关键词
                    local fullName = obj.Name:lower() .. " " .. (obj.Parent and obj.Parent.Name:lower() or "")
                    local shouldSkip = false
                    for _, kw in ipairs(skipBaseKeywords) do
                        if fullName:find(kw) then
                            shouldSkip = true
                            break
                        end
                    end
                    if shouldSkip then
                        print("⏭️ 跳过非厨房 Base: " .. obj.Name)
                        continue
                    end
                    
                    local id = tostring(obj)
                    if not collectedTables[id] then
                        if IsTooCloseToRecent(pos) then
                            print("⏭️ 跳过近距离重复 Base: " .. obj.Name)
                            continue
                        end
                        table.insert(bases, {obj = obj, pos = pos, id = id})
                    end
                end
            end
        end
    end
    return bases
end

local function StartCollect()
    if collectThread then
        task.cancel(collectThread)
        collectThread = nil
    end
    collectedTables = {}
    recentTeleports = {}

    collectThread = task.spawn(function()
        while autoCollect do
            pcall(function()
                local char = LocalPlayer.Character
                if not char then return end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end

                local bases = FindAllBases()
                if #bases == 0 then
                    print("💰 200m内没有可用的 Base 物体")
                    task.wait(2)
                    return
                end

                print("💰 找到 " .. #bases .. " 个可用的 Base 物体")

                for _, baseData in ipairs(bases) do
                    if not autoCollect then break end
                    local target = baseData.obj
                    local pos = baseData.pos
                    local id = baseData.id

                    if target and pos then
                        hrp.CFrame = CFrame.new(pos + Vector3.new(0, 2, 0))
                        task.wait(0.3)
                        
                        -- 记录此次传送位置
                        table.insert(recentTeleports, pos)
                        if #recentTeleports > TELEPORT_HISTORY_LIMIT then
                            table.remove(recentTeleports, 1)
                        end

                        -- 强制按E（多种方式）
                        local pressed = false
                        
                        -- 方法1: 找ProximityPrompt
                        local prompt = nil
                        if target:IsA("Part") then
                            prompt = target:FindFirstChildOfClass("ProximityPrompt")
                        elseif target:IsA("Model") then
                            for _, d in ipairs(target:GetDescendants()) do
                                if d:IsA("ProximityPrompt") then
                                    prompt = d
                                    break
                                end
                            end
                        end
                        if prompt and prompt.Enabled then
                            fireproximityprompt(prompt)
                            pressed = true
                        end
                        
                        -- 方法2: 模拟按键E
                        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                        task.wait(0.05)
                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                        
                        -- 方法3: 如果上面两种都没成功，再试一次火触
                        if not pressed then
                            task.wait(0.1)
                            if prompt and prompt.Enabled then
                                fireproximityprompt(prompt)
                            end
                        end

                        collectedTables[id] = true
                        print("💰 已收 Base: " .. target.Name)

                        task.wait(0.3)
                    end
                end

                collectedTables = {}
                print("💰 一轮完成，等待2秒后继续")
                task.wait(2)
            end)
            task.wait(0.5)
        end
    end)
end

