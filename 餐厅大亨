-- ==================== 变量 ====================
local autoInteract = false
local speedValue = 16
local speedEnabled = false
local espEnabled = false
local espHighlights = {}
local selectedPlayer = nil

-- ==================== 速度循环 ====================
task.spawn(function()
    while true do
        if speedEnabled then
            local c = LocalPlayer.Character
            if c and c:FindFirstChild("Humanoid") then
                c.Humanoid.WalkSpeed = speedValue
            end
        end
        task.wait(0.1)
    end
end)

-- ==================== ESP ====================
local function clearESP()
    for _, obj in pairs(espHighlights) do
        pcall(function() obj:Destroy() end)
    end
    espHighlights = {}
end

local function updateESP()
    clearESP()
    if not espEnabled then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            pcall(function()
                local char = p.Character
                local hl = Instance.new("Highlight")
                hl.FillColor = Color3.fromRGB(0, 150, 255)
                hl.FillTransparency = 0.3
                hl.OutlineColor = Color3.new(1, 1, 1)
                hl.Adornee = char
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Parent = char
                table.insert(espHighlights, hl)
                
                local bb = Instance.new("BillboardGui")
                bb.Size = UDim2.new(0, 200, 0, 30)
                bb.AlwaysOnTop = true
                bb.Parent = char
                local head = char:FindFirstChild("Head")
                if head then bb.Adornee = head end
                
                local label = Instance.new("TextLabel")
                label.Size = UDim2.new(1, 0, 1, 0)
                label.BackgroundTransparency = 1
                label.TextColor3 = Color3.new(1, 1, 1)
                label.Text = p.Name
                label.Font = Enum.Font.SourceSansBold
                label.TextSize = 14
                label.TextStrokeColor3 = Color3.new(0, 0, 0)
                label.TextStrokeTransparency = 0.5
                label.Parent = bb
                table.insert(espHighlights, bb)
            end)
        end
    end
end

task.spawn(function()
    while true do
        if espEnabled then
            updateESP()
        else
            clearESP()
        end
        task.wait(0.5)
    end
end)

-- ==================== 获取所有玩家名字 ====================
local function GetPlayerNames()
    local names = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(names, p.Name)
        end
    end
    return names
end

-- ==================== 传送功能 ====================
local function TeleportToPlayer(playerName)
    if not playerName or playerName == "" then
        WI:Notify({
            Title = "❌ 传送失败",
            Content = "请先选择一名玩家",
            Duration = 2,
            Type = "error"
        })
        return false
    end
    
    local target = Players:FindFirstChild(playerName)
    if not target then
        WI:Notify({
            Title = "❌ 传送失败",
            Content = "玩家不存在",
            Duration = 2,
            Type = "error"
        })
        return false
    end
    
    if not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
        WI:Notify({
            Title = "❌ 传送失败",
            Content = "目标玩家没有角色",
            Duration = 2,
            Type = "error"
        })
        return false
    end
    
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        WI:Notify({
            Title = "❌ 传送失败",
            Content = "你的角色不存在",
            Duration = 2,
            Type = "error"
        })
        return false
    end
    
    local targetPos = target.Character.HumanoidRootPart.Position
    char.HumanoidRootPart.CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0))
    
    WI:Notify({
        Title = "✅ 传送成功",
        Content = "已传送到 " .. playerName,
        Duration = 2,
        Type = "success"
    })
    return true
end

-- ==================== 自动互动（带三层名称检测） ====================
task.spawn(function()
    local skipNames = {"wardrobe","cabinet","closet","bed","衣柜","柜子","床","hide","hiding","painting","画","drawing","canvas","picture","frame","photo","portrait"}
    while true do
        if autoInteract then
            pcall(function()
                local p = LocalPlayer.Character
                if not p or not p:FindFirstChild("HumanoidRootPart") then return end
                local hrp = p.HumanoidRootPart
                local hrpPos = hrp.Position
                
                for _, o in ipairs(Workspace:GetDescendants()) do
                    if o:IsA("ProximityPrompt") and o.Enabled then
                        local pp = o.Parent
                        if not pp then continue end
                        
                        local po = nil
                        if pp:IsA("BasePart") then
                            po = pp.Position
                        elseif pp:IsA("Model") then
                            local bp = pp:FindFirstChildWhichIsA("BasePart")
                            if bp then po = bp.Position end
                        end
                        
                        if po and (po - hrpPos).Magnitude < 10 then
                            local name = pp.Name:lower()
                            local parentName = pp.Parent and pp.Parent.Name:lower() or ""
                            local grandparentName = pp.Parent and pp.Parent.Parent and pp.Parent.Parent.Name:lower() or ""
                            local combined = name .. " " .. parentName .. " " .. grandparentName
                            
                            local shouldSkip = false
                            for _, kw in ipairs(skipNames) do
                                if combined:find(kw) then
                                    shouldSkip = true
                                    break
                                end
                            end
                            
                            if not shouldSkip then
                                if name == "door" or parentName == "door" then
                                    fireproximityprompt(o, 1)
                                else
                                    fireproximityprompt(o)
                                end
                            end
                        end
                    end
                end
            end)
        end
        task.wait(0.15)
    end
end)

