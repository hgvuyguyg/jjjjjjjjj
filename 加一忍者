-- 加一速度忍者键盘逃脱 脚本 v1.0.1
-- WindUI蓝白版 | 自动赢 | 自动重生

local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()
if not WindUI then return end

WindUI:AddTheme({
    Name = "冰白",
    Accent = "#80C0FF",
    Outline = "#6090C0",
    Text = "#FFFFFF",
    Placeholder = "#D0E0FF",
})

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Settings = {
    AutoWinEnabled = false,
    AutoRebirthEnabled = false,
}

local VERSION = "v1.0.1"
local lastWinTime = 0
local lastRebirthTime = 0
local WinDelay = 2 -- 固定2秒
local RebirthDelay = 2 -- 固定2秒

-- 自动赢
local function autoWin()
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        character.HumanoidRootPart.CFrame = CFrame.new(368.7, 23.3, -8170.9)
        return true
    end
    return false
end

-- 自动重生
local function autoRebirth()
    local Event = ReplicatedStorage:FindFirstChild("Packages") and ReplicatedStorage.Packages:FindFirstChild("_Index") and ReplicatedStorage.Packages._Index:FindFirstChild("sleitnick_net@0.2.0") and ReplicatedStorage.Packages._Index["sleitnick_net@0.2.0"]:FindFirstChild("net") and ReplicatedStorage.Packages._Index["sleitnick_net@0.2.0"].net:FindFirstChild("RE/Rebirth/Request")
    
    if Event then
        Event:FireServer()
        return true
    end
    return false
end

-- 自动赢循环（2秒固定）
task.spawn(function()
    while true do
        if Settings.AutoWinEnabled then
            local currentTime = tick()
            if currentTime - lastWinTime >= WinDelay then
                autoWin()
                lastWinTime = currentTime
            end
        end
        task.wait(0.05)
    end
end)

-- 自动重生循环（2秒固定）
task.spawn(function()
    while true do
        if Settings.AutoRebirthEnabled then
            local currentTime = tick()
            if currentTime - lastRebirthTime >= RebirthDelay then
                autoRebirth()
                lastRebirthTime = currentTime
            end
        end
        task.wait(0.05)
    end
end)

local Window = WindUI:CreateWindow({
    Title = "加一速度忍者键盘逃脱",
    Icon = "solar:moon-bold",
    Size = UDim2.fromOffset(400, 350),
    ToggleKey = Enum.KeyCode.RightShift,
    Theme = "冰白",
    Transparent = true,
    ScrollBarEnabled = true,
})

Window:Tab({Title = "公告", Icon = "solar:info-circle-bold"}):Paragraph({
    Title = "黑脚本--加一速度忍者键盘逃脱",
    Desc = "版本: " .. VERSION .. "\n\n支持功能：\n• 自动赢（每2秒传送）\n• 自动重生（每2秒）",
})

local MainTab = Window:Tab({Title = "主要", Icon = "solar:star-bold"})

MainTab:Toggle({
    Title = "自动赢",
    Value = false,
    Callback = function(enabled)
        Settings.AutoWinEnabled = enabled
        
        if enabled then
            WindUI:Notify({
                Title = "自动赢已开启",
                Content = "每2秒传送（固定）",
                Duration = 3
            })
        else
            WindUI:Notify({
                Title = "自动赢已关闭",
                Content = "已停止",
                Duration = 2
            })
        end
    end
})

MainTab:Divider()

MainTab:Toggle({
    Title = "自动重生",
    Value = false,
    Callback = function(enabled)
        Settings.AutoRebirthEnabled = enabled
        
        if enabled then
            WindUI:Notify({
                Title = "自动重生已开启",
                Content = "每2秒重生（固定）",
                Duration = 3
            })
        else
            WindUI:Notify({
                Title = "自动重生已关闭",
                Content = "已停止",
                Duration = 2
            })
        end
    end
})

local SettingsTab = Window:Tab({Title = "设置", Icon = "solar:settings-bold"})

local statusParagraph = SettingsTab:Paragraph({
    Title = "功能状态",
    Desc = "正在加载..."
})

local function updateStatus()
    local status = ""
    if Settings.AutoWinEnabled then
        status = status .. "✅ 自动赢: 已开启 (2秒)\n"
    else
        status = status .. "❌ 自动赢: 未开启\n"
    end
    if Settings.AutoRebirthEnabled then
        status = status .. "✅ 自动重生: 已开启 (2秒)\n"
    else
        status = status .. "❌ 自动重生: 未开启\n"
    end
    statusParagraph:SetDesc(status)
end

RunService.Heartbeat:Connect(function() updateStatus() end)

SettingsTab:Button({
    Title = "关闭面板",
    Callback = function() Window:Close() end
})

Window:OnClose(function() end)

WindUI:Notify({
    Title = "加一速度忍者键盘逃脱",
    Content = VERSION .. " 加载完成",
    Duration = 3
})
