local WI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()
if not WI then return end

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")

-- ==================== 变量 ====================
local antiAfk = false
local speedEnabled = false
local speedValue = 20
local fruitEsp = false
local autoFarm = false
local farmRange = 50
local farmCooldown = 0.3
local cameraAngle = 0
local playerEsp = false
local chestEsp = false
local espHighlights = {}
local useUlt = true
local ultCooldown = 0
local ultInterval = 10
local isAttacking = false
local selectedPlayerName = ""

-- ==================== 防 AFK ====================
task.spawn(function()
    while task.wait(90) do
        if antiAfk then
            pcall(function()
                cameraAngle = (cameraAngle + 1) % 360
                local cam = Workspace.CurrentCamera
                if cam then
                    cam.CFrame = CFrame.new(cam.CFrame.Position) * CFrame.Angles(0, math.rad(cameraAngle), 0)
                end
            end)
        end
    end
end)

-- ==================== 速度循环 ====================
task.spawn(function()
    while task.wait(0.1) do
        if speedEnabled then
            pcall(function()
                local c = LocalPlayer.Character
                if c and c:FindFirstChild("Humanoid") then
                    c.Humanoid.WalkSpeed = speedValue
                end
            end)
        end
    end
end)

-- ==================== 大招 Z 键 ====================
local function PressZ()
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Z, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Z, false, game)
    end)
end

task.spawn(function()
    while task.wait(0.5) do
        if autoFarm and useUlt then
            local now = tick()
            if now - ultCooldown >= ultInterval then
                ultCooldown = now
                PressZ()
            end
        end
    end
end)

-- ==================== 攻击循环 ====================
local function StartAttacking()
    if isAttacking then return end
    isAttacking = true
    task.spawn(function()
        while isAttacking do
            pcall(function()
                local screenSize = Workspace.CurrentCamera.ViewportSize
                local x = screenSize.X - 100
                local y = 100
                VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
                task.wait(0.005)
                VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
            end)
            task.wait(0.05)
        end
    end)
end

local function StopAttacking()
    isAttacking = false
end

-- ==================== 自动刷NPC ====================
local function isNPC(obj)
    if not obj or not obj:IsA("Model") then return false end
    if Players:GetPlayerFromCharacter(obj) then return false end
    local hum = obj:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if not obj:FindFirstChild("HumanoidRootPart") then return false end
    local name = obj.Name:lower()
    if name:find("shop") or name:find("keeper") or name:find("store") or name:find("merchant") then return false end
    return true
end

local function moveToNPC()
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local target = nil
        local targetDist = math.huge
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if isNPC(obj) then
                local zhrp = obj:FindFirstChild("HumanoidRootPart")
                if zhrp then
                    local dist = (hrp.Position - zhrp.Position).Magnitude
                    if dist < farmRange and dist < targetDist then
                        targetDist = dist
                        target = obj
                    end
                end
            end
        end
        if target then
            local zhrp = target:FindFirstChild("HumanoidRootPart")
            if zhrp then
                hrp.CFrame = zhrp.CFrame * CFrame.new(0, 0, -3)
                pcall(function()
                    local cam = Workspace.CurrentCamera
                    if cam then
                        cam.CFrame = CFrame.new(cam.CFrame.Position, zhrp.Position + Vector3.new(0, 1.5, 0))
                    end
                end)
            end
        end
    end)
end

task.spawn(function()
    while task.wait(farmCooldown) do
        if autoFarm then
            moveToNPC()
            if not isAttacking then StartAttacking() end
        else
            StopAttacking()
        end
    end
end)

-- ==================== ESP ====================
local function clearESP()
    for _, obj in pairs(espHighlights) do
        pcall(function() obj:Destroy() end)
    end
    espHighlights = {}
end

local function updatePlayerESP()
    if not playerEsp then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            pcall(function()
                local char = p.Character
                local hl = Instance.new("Highlight")
                hl.FillColor = Color3.fromRGB(0, 150, 255)
                hl.FillTransparency = 0.3
                hl.OutlineColor = Color3.new(1, 1, 1)
                hl.Adornee = char
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Parent = char
                table.insert(espHighlights, hl)
            end)
        end
    end
end

local function updateFruitESP()
    if not fruitEsp then return end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        pcall(function()
            if obj:IsA("Model") and obj.Name:lower():find("fruit") then
                local hl = Instance.new("Highlight")
                hl.FillColor = Color3.fromRGB(255, 200, 50)
                hl.FillTransparency = 0.2
                hl.OutlineColor = Color3.new(1, 1, 1)
                hl.Adornee = obj
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Parent = obj
                table.insert(espHighlights, hl)
            end
        end)
    end
end

local function updateChestESP()
    if not chestEsp then return end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        pcall(function()
            if obj:IsA("Model") and obj.Name:find("宝箱") then
                local hl = Instance.new("Highlight")
                hl.FillColor = Color3.fromRGB(255, 215, 0)
                hl.FillTransparency = 0.2
                hl.OutlineColor = Color3.new(1, 1, 1)
                hl.Adornee = obj
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Parent = obj
                table.insert(espHighlights, hl)
            end
        end)
    end
end

task.spawn(function()
    while task.wait(0.5) do
        clearESP()
        if playerEsp then updatePlayerESP() end
        if fruitEsp then updateFruitESP() end
        if chestEsp then updateChestESP() end
    end
end)

-- ==================== 传送功能 ====================
local function GetPlayerNames()
    local names = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(names, p.Name)
        end
    end
    return names
end

local function TeleportToPlayer(playerName)
    if not playerName or playerName == "" then
        WI:Notify({Title = "传送失败", Content = "请先选择一名玩家", Duration = 2, Type = "error"})
        return
    end
    local target = Players:FindFirstChild(playerName)
    if not target then
        WI:Notify({Title = "传送失败", Content = "玩家不存在", Duration = 2, Type = "error"})
        return
    end
    if not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
        WI:Notify({Title = "传送失败", Content = "目标玩家没有角色", Duration = 2, Type = "error"})
        return
    end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        WI:Notify({Title = "传送失败", Content = "你的角色不存在", Duration = 2, Type = "error"})
        return
    end
    local targetPos = target.Character.HumanoidRootPart.Position
    char.HumanoidRootPart.CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0))
    WI:Notify({Title = "传送成功", Content = "已传送到 " .. playerName, Duration = 2, Type = "success"})
end

