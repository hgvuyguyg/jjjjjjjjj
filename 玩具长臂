-- 加一长臂玩具逃脱 脚本 v1.0.3
-- WindUI蓝白版 | 自动赢

local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()
if not WindUI then return end

WindUI:AddTheme({
    Name = "冰白",
    Accent = "#80C0FF",
    Outline = "#6090C0",
    Text = "#FFFFFF",
    Placeholder = "#D0E0FF",
})

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local autoWin = false
local startPos = Vector3.new(1156.1, 471.6, 2919.3)
local targetPos = Vector3.new(1156.1, 471.6, 2919.3)
local isWalking = false

local function walkToTarget()
    local char = LocalPlayer.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    isWalking = true
    
    hrp.CFrame = CFrame.new(startPos + Vector3.new(0, 2, 0))
    task.wait(0.2)
    hrp.CFrame = CFrame.new(startPos)
    task.wait(0.2)
    
    local oldSpeed = humanoid.WalkSpeed
    humanoid.WalkSpeed = 20
    
    humanoid:MoveTo(targetPos)
    
    local timeout = 0
    while timeout < 30 do
        if not autoWin then break end
        local dist = (hrp.Position - targetPos).Magnitude
        if dist < 5 then
            break
        end
        task.wait(0.5)
        timeout = timeout + 0.5
    end
    
    hrp.CFrame = CFrame.new(targetPos)
    humanoid.WalkSpeed = oldSpeed
    isWalking = false
end

task.spawn(function()
    while true do
        if autoWin and not isWalking then
            walkToTarget()
            task.wait(3)
        else
            task.wait(0.5)
        end
    end
end)

local Window = WindUI:CreateWindow({
    Title = "加一长臂玩具逃脱",
    Icon = "solar:moon-bold",
    Size = UDim2.fromOffset(600, 350),
    ToggleKey = Enum.KeyCode.RightShift,
    Theme = "冰白",
    Transparent = true,
    ScrollBarEnabled = true,
})

Window:Tab({Title = "公告", Icon = "solar:info-circle-bold"}):Paragraph({
    Title = "黑脚本--加一长臂玩具逃脱 v1.0.3",
    Desc = "功能：自动赢\n\n坐标: 1156.1, 471.6, 2919.3"
})

local MainTab = Window:Tab({Title = "主要功能", Icon = "solar:star-bold"})

MainTab:Toggle({
    Title = "自动赢",
    Value = false,
    Callback = function(v)
        autoWin = v
        if v then
            WindUI:Notify({Title = "已开启", Content = "开始自动赢", Duration = 2})
        else
            WindUI:Notify({Title = "已关闭", Content = "停止自动赢", Duration = 2})
        end
    end
})

MainTab:Divider()

MainTab:Button({
    Title = "手动传送",
    Callback = function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = CFrame.new(targetPos)
            WindUI:Notify({Title = "传送成功", Content = "已到达目标点", Duration = 2})
        else
            WindUI:Notify({Title = "失败", Content = "找不到角色", Duration = 2})
        end
    end
})

local SettingsTab = Window:Tab({Title = "设置", Icon = "solar:settings-bold"})
local statusPara = SettingsTab:Paragraph({Title = "功能状态", Desc = "加载中..."})

task.spawn(function()
    while true do
        local status = ""
        status = status .. "自动赢: " .. (autoWin and "已开启" or "未开启") .. "\n"
        status = status .. "目标点: 1156.1, 471.6, 2919.3\n"
        status = status .. "帧率: " .. math.floor(1 / task.wait()) .. " FPS"
        statusPara:SetDesc(status)
        task.wait(1)
    end
end)

SettingsTab:Button({
    Title = "关闭面板",
    Callback = function()
        Window:Close()
    end
})

Window:OnClose(function()
    autoWin = false
end)

WindUI:Notify({
    Title = "加一长臂玩具逃脱",
    Content = "v1.0.3 加载完成",
    Duration = 3
})
