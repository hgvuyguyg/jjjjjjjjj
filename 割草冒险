-- ==================== 清理周围草 ====================
local function clearGrassAround()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return 0 end
    local hrp = char.HumanoidRootPart
    local count = 0
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        pcall(function()
            if obj:IsA("BasePart") and obj.Name:find("Grass") then
                local dist = (hrp.Position - obj.Position).Magnitude
                if dist <= 50 then
                    obj:Destroy()
                    count = count + 1
                end
            end
        end)
    end
    return count
end

-- ==================== 删除所有草 ====================
local function deleteAllGrass()
    local count = 0
    for i = 2, 100 do
        local grassName = "Grass_" .. i
        for _, obj in ipairs(Workspace:GetDescendants()) do
            pcall(function()
                if obj.Name == grassName then
                    obj:Destroy()
                    count = count + 1
                end
            end)
        end
    end
    return count
end

spawn(function()
