-- ==================== 获取点击事件 ====================
local function getClickEvent()
    local remote = game:GetService("ReplicatedStorage")
    if remote then
        local Packages = remote:FindFirstChild("Packages")
        if Packages then
            local index = Packages:FindFirstChild("_Index")
            if index then
                local knit = index:FindFirstChild("acecateer_knit@1.7.2")
                if knit then
                    local services = knit:FindFirstChild("knit")
                    if services then
                        local strength = services:FindFirstChild("Services")
                        if strength then
                            local strengthService = strength:FindFirstChild("StrengthService")
                            if strengthService then
                                local re = strengthService:FindFirstChild("RE")
                                if re then
                                    return re:FindFirstChild("ClickRequested")
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return nil
end

-- ==================== 自动点击 ====================
RunService.RenderStepped:Connect(function()
    if autoClick then
        pcall(function()
            local event = getClickEvent()
            if event then
                event:FireServer()
            end
        end)
    end
end)

