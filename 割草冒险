            pcall(function() deleteAllGrass() end)
        end
        task.wait(0.5)
    end
end)

-- ==================== 传送到稀有物品（全部改用数字匹配）====================
local function teleportToRareItem()
    if selectedRareItem == "" then
        WI:Notify({Title = "传送失败", Content = "请先选择物品", Duration = 2})
        return
    end
    
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        WI:Notify({Title = "传送失败", Content = "角色不存在", Duration = 2})
        return
    end
    local hrp = char.HumanoidRootPart
    
    -- 全部用数字前缀匹配
    local numberPrefix = ""
    if selectedRareItem == "卷轴戒指" then numberPrefix = "26_"
    elseif selectedRareItem == "黎明王冠" then numberPrefix = "30_"
    elseif selectedRareItem == "微型传送门" then numberPrefix = "27_"
    elseif selectedRareItem == "彗星之心" then numberPrefix = "29_"
    elseif selectedRareItem == "月亮碎片" then numberPrefix = "32_"
    elseif selectedRareItem == "黑洞" then numberPrefix = "04_"
    elseif selectedRareItem == "天堂之星" then numberPrefix = "39_"
    elseif selectedRareItem == "生命之星" then numberPrefix = "33_"
    elseif selectedRareItem == "萨满面具" then numberPrefix = "35_"
    end
    
    local target = nil
    local minDist = math.huge
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name:find(numberPrefix) then
            local root = obj:IsA("BasePart") and obj or (obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildOfClass("BasePart"))
            if root then
                local d = (hrp.Position - root.Position).Magnitude
                if d < minDist then
                    minDist = d
                    target = root
                end
            end
        end
    end
    
    if target then
        hrp.CFrame = target.CFrame * CFrame.new(0, 3, 0)
        local cleared = clearGrassAround()
        if cleared > 0 then
            WI:Notify({Title = "传送成功", Content = "已到达 | 清" .. cleared .. "草", Duration = 2})
        else
            WI:Notify({Title = "传送成功", Content = "已到达", Duration = 2})
        end
    else
        WI:Notify({Title = "传送失败", Content = "没找到此物品", Duration = 2})
    end
end

-- ==================== 传送到世界一终点 ====================
local function teleportToWorldEnd()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        WI:Notify({Title = "传送失败", Content = "角色不存在", Duration = 2})
        return
    end
    local hrp = char.HumanoidRootPart
    hrp.CFrame = CFrame.new(742, 36.6, 4.3)
    local cleared = clearGrassAround()
    if cleared > 0 then
        WI:Notify({Title = "传送成功", Content = "已到世界一终点 | 清" .. cleared .. "草", Duration = 2})
    else
        WI:Notify({Title = "传送成功", Content = "已到世界一终点", Duration = 2})
    end
end

-- ==================== 获取所有玩家 ====================
local function getNames()
    local n = {}
    for _, p in ipairs(Players:GetPlayers()) do 
        if p ~= LocalPlayer then table.insert(n, p.Name) end 
    end
    if #n == 0 then table.insert(n, "无玩家") end
    return n
end

local function tpPlayer(name)
    if not name or name == "" or name == "无玩家" then return end
    local t = Players:FindFirstChild(name)
    if t and t.Character and t.Character:FindFirstChild("HumanoidRootPart") then
        local c = LocalPlayer.Character
        if c and c:FindFirstChild("HumanoidRootPart") then
            c.HumanoidRootPart.CFrame = t.Character.HumanoidRootPart.CFrame * CFrame.new(0, 2, 0)
            WI:Notify({Title = "传送成功", Content = name, Duration = 2})
        end
    end
end

-- ==================== 玩家透视 ====================
local function clearPlayer()
    for _, obj in ipairs(playerESPObjects) do 
        pcall(function() obj:Destroy() end) 
    end
    playerESPObjects = {}
end

local function refreshPlayerESP()
    clearPlayer()
    if not playerESP then return end
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            pcall(function()
                local c = plr.Character
                local root = c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Head")
                if not root then return end

                local hl = Instance.new("Highlight")
                hl.FillColor = playerESPColor
                hl.FillTransparency = 0.3
                hl.OutlineColor = playerESPColor
                hl.OutlineTransparency = 0.2
                hl.Adornee = c
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Parent = c
                table.insert(playerESPObjects, hl)

                local bb = Instance.new("BillboardGui")
                bb.Size = UDim2.new(0, 200, 0, 30)
                bb.StudsOffset = Vector3.new(0, 3, 0)
                bb.AlwaysOnTop = true
                bb.Adornee = root
                bb.Parent = root
                table.insert(playerESPObjects, bb)

                local lb = Instance.new("TextLabel")
                lb.Size = UDim2.new(1, 0, 1, 0)
                lb.BackgroundTransparency = 1
                lb.Text = plr.Name
                lb.TextColor3 = playerESPColor
                lb.TextStrokeTransparency = 0
                lb.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                lb.Font = Enum.Font.SourceSansBold
                lb.TextSize = 16
                lb.Parent = bb

                if showDistance then
                    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if myRoot then
                        local d = math.floor((myRoot.Position - root.Position).Magnitude)
                        local db = Instance.new("BillboardGui")
                        db.Size = UDim2.new(0, 100, 0, 20)
                        db.StudsOffset = Vector3.new(0, -1.5, 0)
                        db.AlwaysOnTop = true
                        db.Adornee = root
                        db.Parent = root
                        table.insert(playerESPObjects, db)

                        local dl = Instance.new("TextLabel")
                        dl.Size = UDim2.new(1, 0, 1, 0)
                        dl.BackgroundTransparency = 1
                        dl.Text = d .. "m"
                        dl.TextColor3 = Color3.fromRGB(255, 255, 255)
                        dl.TextStrokeTransparency = 0
                        dl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                        dl.Font = Enum.Font.SourceSansBold
                        dl.TextSize = 14
                        dl.Parent = db
                    end
                end
            end)
        end
    end
end

task.spawn(function()
    while task.wait(1.5) do
        pcall(function() refreshPlayerESP() end)
    end
end)

