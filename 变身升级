            end
        end)
    end
end)

-- ==================== 创建冲刺按钮 ====================
local function createSprintButton()
    if sprintGui then
        sprintGui:Destroy()
    end
    
    sprintGui = Instance.new("ScreenGui")
    sprintGui.Name = "SprintButton"
    sprintGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sprintGui.ResetOnSpawn = false
    sprintGui.Parent = game:GetService("CoreGui")

    sprintButton = Instance.new("TextButton")
    sprintButton.Size = UDim2.new(0, 70, 0, 70)
    sprintButton.Position = UDim2.new(1, -100, 1, -300)
    sprintButton.BackgroundColor3 = Color3.fromRGB(80, 160, 255)
    sprintButton.BackgroundTransparency = 0.3
    sprintButton.BorderSizePixel = 0
    sprintButton.Text = "冲刺"
    sprintButton.TextColor3 = Color3.new(1, 1, 1)
    sprintButton.Font = Enum.Font.SourceSansBold
    sprintButton.TextSize = 16
    sprintButton.ZIndex = 9999
    sprintButton.Parent = sprintGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = sprintButton

    cooldownLabel = Instance.new("TextLabel")
    cooldownLabel.Size = UDim2.new(0, 100, 0, 25)
    cooldownLabel.Position = UDim2.new(1, -115, 1, -270)
    cooldownLabel.BackgroundTransparency = 1
    cooldownLabel.Text = ""
    cooldownLabel.TextColor3 = Color3.new(1, 1, 1)
    cooldownLabel.Font = Enum.Font.SourceSansBold
    cooldownLabel.TextSize = 14
    cooldownLabel.TextStrokeTransparency = 0
    cooldownLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    cooldownLabel.ZIndex = 9999
    cooldownLabel.Parent = sprintGui

    sprintButton.MouseButton1Click:Connect(function()
        if sprintCooldown then return end
        sprintCooldown = true
        sprintButton.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
        sprintButton.Text = "冲刺中"
        
        spawn(function()
            pcall(function()
                local c = LocalPlayer.Character
                if c and c:FindFirstChild("Humanoid") then
                    c.Humanoid.WalkSpeed = 200
                end
            end)
            task.wait(sprintDuration)
            pcall(function()
                local c = LocalPlayer.Character
                if c and c:FindFirstChild("Humanoid") then
                    c.Humanoid.WalkSpeed = speedBoost and speedValue or 16
                end
            end)
            
            for i = 3, 1, -1 do
                cooldownLabel.Text = "冷却 " .. i .. "秒"
                sprintButton.Text = i .. "s"
                task.wait(1)
            end
            cooldownLabel.Text = ""
            sprintCooldown = false
            sprintButton.BackgroundColor3 = Color3.fromRGB(80, 160, 255)
            sprintButton.Text = "冲刺"
        end)
    end)
end

-- ==================== 删除冲刺按钮 ====================
local function removeSprintButton()
    if sprintGui then
        sprintGui:Destroy()
        sprintGui = nil
        sprintButton = nil
        cooldownLabel = nil
    end
end

-- ==================== 玩家ESP ====================
local function clearPlayerESP()
    for _, obj in ipairs(playerESPObjects) do
        pcall(function() obj:Destroy() end)
    end
    playerESPObjects = {}
end

local function refreshPlayerESP()
    clearPlayerESP()
    if not playerESP then return end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            pcall(function()
                local c = plr.Character
                local root = c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Head")
                if not root then return end

                local hl = Instance.new("Highlight")
                hl.FillColor = playerESPColor
                hl.FillTransparency = 0.3
                hl.OutlineColor = playerESPColor
                hl.OutlineTransparency = 0.2
                hl.Adornee = c
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Parent = c
                table.insert(playerESPObjects, hl)

                local bb = Instance.new("BillboardGui")
                bb.Size = UDim2.new(0, 200, 0, 30)
                bb.StudsOffset = Vector3.new(0, 3, 0)
                bb.AlwaysOnTop = true
                bb.Adornee = root
                bb.Parent = root
                table.insert(playerESPObjects, bb)

                local lb = Instance.new("TextLabel")
                lb.Size = UDim2.new(1, 0, 1, 0)
                lb.BackgroundTransparency = 1
                lb.Text = plr.Name
                lb.TextColor3 = playerESPColor
                lb.TextStrokeTransparency = 0
                lb.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                lb.Font = Enum.Font.SourceSansBold
                lb.TextSize = 16
                lb.Parent = bb

                if showDistance then
                    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if myRoot then
                        local d = math.floor((myRoot.Position - root.Position).Magnitude)
                        local db = Instance.new("BillboardGui")
                        db.Size = UDim2.new(0, 100, 0, 20)
                        db.StudsOffset = Vector3.new(0, -1.5, 0)
                        db.AlwaysOnTop = true
                        db.Adornee = root
                        db.Parent = root
                        table.insert(playerESPObjects, db)

                        local dl = Instance.new("TextLabel")
                        dl.Size = UDim2.new(1, 0, 1, 0)
                        dl.BackgroundTransparency = 1
                        dl.Text = d .. "m"
                        dl.TextColor3 = Color3.fromRGB(255, 255, 255)
                        dl.TextStrokeTransparency = 0
                        dl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                        dl.Font = Enum.Font.SourceSansBold
                        dl.TextSize = 14
                        dl.Parent = db
                    end
                end
            end)
        end
    end
end

task.spawn(function()
    while task.wait(1.5) do
        pcall(function() refreshPlayerESP() end)
    end
end)

-- ==================== 检查附近是否有玩家 ====================
local function isPlayerNearby(radius)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    local hrp = char.HumanoidRootPart
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local d = (hrp.Position - plr.Character.HumanoidRootPart.Position).Magnitude
            if d < radius then return true end
        end
    end
    return false
end

-- ==================== 自动吃食 ====================
spawn(function()
    while true do
        if autoEat then
            if autoDodge and isPlayerNearby(dodgeRange) then
                task.wait(0.2)
                return
            end

            pcall(function()
                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then
                    task.wait(0.5)
                    return
                end
                local hrp = char.HumanoidRootPart
                local humanoid = char:FindFirstChild("Humanoid")
                if not humanoid then
                    task.wait(0.5)
                    return
                end

                local closest, closestDist = nil, math.huge
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj.Name:find("Berry") and not visitedBerries[obj] then
                        local root = getRoot(obj)
                        if root then
                            local d = (hrp.Position - root.Position).Magnitude
                            if d < closestDist then
                                closestDist = d
                                closest = root
                            end
                        end
                    end
                end

                if not closest then
                    visitedBerries = {}
                    task.wait(1)
                    return
                end

                local targetObj = nil
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj.Name:find("Berry") and not visitedBerries[obj] then
                        local root = getRoot(obj)
                        if root == closest then
                            targetObj = obj
                            break
                        end
                    end
                end

                local startTime = tick()
                local stuckTime = 0
                local lastPos = hrp.Position

                while tick() - startTime < 15 and autoEat do
                    if autoDodge and isPlayerNearby(dodgeRange) then
                        humanoid.WalkSpeed = 16
                        return
                    end

                    local dist = (hrp.Position - closest.Position).Magnitude
                    if dist < 5 then break end

                    if not sprintCooldown then
                        humanoid.WalkSpeed = speedBoost and speedValue or 16
                    end
                    humanoid:MoveTo(closest.Position)
                    task.wait(0.3)

                    local movedDist = (hrp.Position - lastPos).Magnitude
                    if movedDist < 0.5 then
                        stuckTime = stuckTime + 0.3
                        if stuckTime > 2 then
                            if targetObj then visitedBerries[targetObj] = true end
                            break
                        end
                    else
                        stuckTime = 0
                    end
                    lastPos = hrp.Position
                end

                if not sprintCooldown then
                    humanoid.WalkSpeed = speedBoost and speedValue or 16
                end

                local finalDist = (hrp.Position - closest.Position).Magnitude
                if finalDist < 8 and targetObj then
                    visitedBerries[targetObj] = true
                end
                task.wait(0.2)
            end)
        end
        task.wait(0.2)
    end
end)

-- ==================== 自动躲玩家 ====================
spawn(function()
    while true do
        if autoDodge then
            pcall(function()
                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then
                    task.wait(0.1)
                    return
                end
                local hrp = char.HumanoidRootPart
                local humanoid = char:FindFirstChild("Humanoid")
                if not humanoid then
                    task.wait(0.1)
                    return
                end

                local nearestPlayer = nil
                local nearestDist = math.huge

                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                        local targetHRP = plr.Character.HumanoidRootPart
                        local d = (hrp.Position - targetHRP.Position).Magnitude
                        if d < nearestDist then
                            nearestDist = d
                            nearestPlayer = plr
                        end
                    end
                end

                if nearestPlayer and nearestDist < dodgeRange then
                    local targetHRP = nearestPlayer.Character.HumanoidRootPart

                    local escapeEnd = tick() + 10
                    while tick() < escapeEnd and autoDodge do
                        local currentDist = (hrp.Position - targetHRP.Position).Magnitude
                        if currentDist >= dodgeRange + 5 then
                            break
                        end

                        local newAway = (hrp.Position - targetHRP.Position).Unit
                        local runPos = hrp.Position + newAway * 30
                        if not sprintCooldown then
                            humanoid.WalkSpeed = speedBoost and speedValue or 16
                        end
                        humanoid:MoveTo(runPos)
                        task.wait(0.3)
                    end

                    if not sprintCooldown then
                        humanoid.WalkSpeed = speedBoost and speedValue or 16
                    end
                end
            end)
        end
        task.wait(0.1)
    end
end)

