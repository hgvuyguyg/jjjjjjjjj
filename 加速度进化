            WindUI:Notify({
                Title = "循环调速度已关闭",
                Content = "已停止",
                Duration = 2
            })
        end
    end
})

MainTab:Slider({
    Title = "移动速度值 (16-500)",
    Value = {Min = 16, Max = 500, Default = 100},
    Step = 1,
    Callback = function(speed)
        Settings.WalkSpeedValue = speed
        if Settings.AutoWalkSpeedEnabled then
            setWalkSpeed()
        end
    end
})

MainTab:Divider()

MainTab:Toggle({
    Title = "自动重生",
    Value = false,
    Callback = function(enabled)
        Settings.AutoRebirthEnabled = enabled
        
        if enabled then
            WindUI:Notify({
                Title = "自动重生已开启",
                Content = "延迟: 10秒（固定）",
                Duration = 3
            })
        else
            WindUI:Notify({
                Title = "自动重生已关闭",
                Content = "已停止",
                Duration = 2
            })
        end
    end
})

local SettingsTab = Window:Tab({Title = "设置", Icon = "solar:settings-bold"})

local statusParagraph = SettingsTab:Paragraph({
    Title = "功能状态",
    Desc = "正在加载..."
})

local function updateStatus()
    local status = ""
    
    if Settings.AutoSpeedEnabled then
        status = status .. "✅ 循环获得速度: 已开启\n"
    else
        status = status .. "❌ 循环获得速度: 未开启\n"
    end
    
    if Settings.AutoEvolveEnabled then
        status = status .. "✅ 自动进化: 已开启\n"
    else
        status = status .. "❌ 自动进化: 未开启\n"
    end
    
    if Settings.AutoWinEnabled then
        status = status .. "✅ 循环自动胜利: 已开启\n"
    else
        status = status .. "❌ 循环自动胜利: 未开启\n"
    end
    
    if Settings.AutoWalkSpeedEnabled then
        status = status .. "✅ 循环调速度: 已开启 (" .. Settings.WalkSpeedValue .. ")\n"
    else
        status = status .. "❌ 循环调速度: 未开启\n"
    end
    
    if Settings.AutoRebirthEnabled then
        status = status .. "✅ 自动重生: 已开启 (10秒)\n"
    else
        status = status .. "❌ 自动重生: 未开启\n"
    end
    
    statusParagraph:SetDesc(status)
end

RunService.Heartbeat:Connect(function()
    updateStatus()
end)

SettingsTab:Button({
    Title = "关闭面板",
    Callback = function()
        Window:Close()
    end
})

Window:OnClose(function()
    Settings.AutoSpeedEnabled = false
    Settings.AutoEvolveEnabled = false
    Settings.AutoWinEnabled = false
    Settings.AutoWalkSpeedEnabled = false
    Settings.AutoRebirthEnabled = false
end)

WindUI:Notify({
    Title = "加一速度进化",
    Content = VERSION .. " 加载完成",
    Duration = 3
})
