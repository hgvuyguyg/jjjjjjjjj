-- 加一速度进化 脚本 v1.1.2
-- WindUI蓝白版 | 循环获得速度 | 自动进化 | 循环自动胜利 | 循环调速度 | 自动重生

local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()
if not WindUI then return end

WindUI:AddTheme({
    Name = "冰白",
    Accent = "#80C0FF",
    Outline = "#6090C0",
    Text = "#FFFFFF",
    Placeholder = "#D0E0FF",
})

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Settings = {
    AutoSpeedEnabled = false,
    AutoEvolveEnabled = false,
    AutoWinEnabled = false,
    AutoWalkSpeedEnabled = false,
    AutoRebirthEnabled = false,
    SpeedDelay = 0.1,
    EvolveDelay = 1,
    WinDelay = 1,
    WalkSpeedValue = 100,
}

local VERSION = "v1.1.2"
local lastSpeedTime = 0
local lastEvolveTime = 0
local lastWinTime = 0
local lastWalkSpeedTime = 0
local lastRebirthTime = 0
local RebirthDelay = 10 -- 固定10秒不可改

-- 获得速度
local function addSpeed()
    local Event = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Shared") and ReplicatedStorage.Modules.Shared:FindFirstChild("RemoteEventService") and ReplicatedStorage.Modules.Shared.RemoteEventService:FindFirstChild("AddSpeedRemoteEvent")
    
    if Event then
        Event:FireServer()
        return true
    end
    
    return false
end

-- 自动进化
local function evolve()
    local Event = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Shared") and ReplicatedStorage.Modules.Shared:FindFirstChild("RemoteEventService") and ReplicatedStorage.Modules.Shared.RemoteEventService:FindFirstChild("EvolutionRemoteEvent")
    
    if Event then
        Event:FireServer({
            Action = "Evolve"
        })
        return true
    end
    
    return false
end

-- 自动胜利
local function autoWin()
    local player = LocalPlayer
    if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        player.Character.HumanoidRootPart.CFrame = CFrame.new(7351.1, 94, 36.4)
        return true
    end
    return false
end

-- 循环调速度（每秒设置一次）
local function setWalkSpeed()
    local player = LocalPlayer
    if player and player.Character and player.Character:FindFirstChild("Humanoid") then
        player.Character.Humanoid.WalkSpeed = Settings.WalkSpeedValue
        return true
    end
    return false
end

-- 自动重生
local function rebirth()
    local Event = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Shared") and ReplicatedStorage.Modules.Shared:FindFirstChild("RemoteEventService") and ReplicatedStorage.Modules.Shared.RemoteEventService:FindFirstChild("RebirthRemoteEvent")
    
    if Event then
        Event:FireServer()
        return true
    end
    
    return false
end

-- 循环获得速度
task.spawn(function()
    while true do
        if Settings.AutoSpeedEnabled then
            local currentTime = tick()
            if currentTime - lastSpeedTime >= Settings.SpeedDelay then
                addSpeed()
                lastSpeedTime = currentTime
            end
        end
        task.wait(0.01)
    end
end)

-- 循环自动进化
task.spawn(function()
    while true do
        if Settings.AutoEvolveEnabled then
            local currentTime = tick()
            if currentTime - lastEvolveTime >= Settings.EvolveDelay then
                evolve()
                lastEvolveTime = currentTime
            end
        end
        task.wait(0.01)
    end
end)

-- 循环自动胜利
task.spawn(function()
    while true do
        if Settings.AutoWinEnabled then
            local currentTime = tick()
            if currentTime - lastWinTime >= Settings.WinDelay then
                autoWin()
                lastWinTime = currentTime
            end
        end
        task.wait(0.01)
    end
end)

-- 循环调速度（每秒设置一次）
task.spawn(function()
    while true do
        if Settings.AutoWalkSpeedEnabled then
            local currentTime = tick()
            if currentTime - lastWalkSpeedTime >= 1 then -- 每秒设置一次
                setWalkSpeed()
                lastWalkSpeedTime = currentTime
            end
        end
        task.wait(0.01)
    end
end)

-- 循环自动重生
task.spawn(function()
    while true do
        if Settings.AutoRebirthEnabled then
            local currentTime = tick()
            if currentTime - lastRebirthTime >= RebirthDelay then
                rebirth()
                lastRebirthTime = currentTime
            end
        end
        task.wait(0.01)
    end
end)

