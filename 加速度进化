MainTab:Divider()

MainTab:Toggle({
    Title = "循环自动胜利",
    Value = false,
    Callback = function(enabled)
        Settings.AutoWinEnabled = enabled
        
        if enabled then
            WindUI:Notify({
                Title = "循环自动胜利已开启",
                Content = "延迟: " .. Settings.WinDelay .. "秒",
                Duration = 3
            })
        else
            WindUI:Notify({
                Title = "循环自动胜利已关闭",
